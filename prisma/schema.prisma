// =============================================================================
// Sophia Wellness — Quản lý kho
// Lõi nghiệp vụ: tồn kho theo LÔ + HẠN SỬ DỤNG (HSD), nhập/xuất kho, cảnh báo.
// Áp dụng cho 4 nhóm hàng: mỹ phẩm/skincare, thực phẩm chức năng,
// vật tư tiêu hao spa, thiết bị & máy.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// RBAC — người dùng / vai trò / quyền
// -----------------------------------------------------------------------------
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  roles     UserRole[]
  receipts  GoodsReceipt[] @relation("ReceiptCreatedBy")
  issues    GoodsIssue[]   @relation("IssueCreatedBy")
  auditLogs AuditLog[]

  @@map("users")
}

model Role {
  id          String           @id @default(cuid())
  code        String           @unique
  name        String
  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id    String           @id @default(cuid())
  code  String           @unique
  name  String
  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// -----------------------------------------------------------------------------
// Danh mục
// -----------------------------------------------------------------------------
model Warehouse {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  address   String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  batches   StockBatch[]
  receipts  GoodsReceipt[]
  issues    GoodsIssue[]
  movements StockMovement[]

  @@map("warehouses")
}

model Supplier {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  phone     String?
  email     String?
  address   String?
  taxCode   String?  @map("tax_code")
  note      String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  receipts GoodsReceipt[]
  batches  StockBatch[]

  @@map("suppliers")
}

// Nhóm hàng: mỹ phẩm/skincare, TPCN, vật tư tiêu hao, thiết bị...
model Category {
  id        String    @id @default(cuid())
  code      String    @unique
  name      String
  note      String?
  createdAt DateTime  @default(now()) @map("created_at")
  products  Product[]

  @@map("categories")
}

// Chế độ quản lý tồn:
//  - LOT: quản lý theo lô (bắt buộc mã lô khi nhập), có thể có HSD.
//  - QUANTITY: chỉ đếm số lượng (vật tư/thiết bị không cần lô).
enum TrackingMode {
  LOT
  QUANTITY
}

model Product {
  id              String       @id @default(cuid())
  sku             String       @unique
  barcode         String?      @unique
  name            String
  brand           String?
  categoryId      String?      @map("category_id")
  category        Category?    @relation(fields: [categoryId], references: [id])
  trackingMode    TrackingMode @default(LOT) @map("tracking_mode")
  // Bắt buộc nhập HSD khi nhận hàng (mỹ phẩm, TPCN thường = true).
  requiresExpiry  Boolean      @default(false) @map("requires_expiry")
  uom             String       @default("Cái") // đơn vị tính
  minStock        Float?       @map("min_stock") // định mức tồn tối thiểu
  // Số ngày trước HSD bắt đầu cảnh báo; null = dùng mặc định hệ thống (60).
  expiryAlertDays Int?         @map("expiry_alert_days")
  note            String?
  isActive        Boolean      @default(true) @map("is_active")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  batches      StockBatch[]
  receiptItems GoodsReceiptItem[]
  issueItems   GoodsIssueItem[]
  movements    StockMovement[]

  @@map("products")
}

// -----------------------------------------------------------------------------
// Tồn kho — mỗi lô (batch) là một đơn vị tồn của 1 sản phẩm tại 1 kho.
// Sản phẩm QUANTITY dùng 1 lô "không mã / không HSD" gộp chung.
// -----------------------------------------------------------------------------
model StockBatch {
  id          String    @id @default(cuid())
  productId   String    @map("product_id")
  product     Product   @relation(fields: [productId], references: [id])
  warehouseId String    @map("warehouse_id")
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  batchCode   String?   @map("batch_code") // mã lô/số lô (null với QUANTITY)
  expiryDate  DateTime? @map("expiry_date") // HSD
  mfgDate     DateTime? @map("mfg_date")    // ngày sản xuất
  quantity    Float     @default(0) // tồn hiện tại của lô
  unitCost    Float?    @map("unit_cost") // giá vốn / đơn vị
  supplierId  String?   @map("supplier_id")
  supplier    Supplier? @relation(fields: [supplierId], references: [id])
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  movements  StockMovement[]
  issueItems GoodsIssueItem[]

  @@index([productId, warehouseId])
  @@index([expiryDate])
  @@map("stock_batches")
}

// -----------------------------------------------------------------------------
// Nhập kho
// -----------------------------------------------------------------------------
enum DocStatus {
  DRAFT
  POSTED
  CANCELLED
}

model GoodsReceipt {
  id          String    @id @default(cuid())
  code        String    @unique // mã phiếu nhập PN-xxxx
  supplierId  String    @map("supplier_id")
  supplier    Supplier  @relation(fields: [supplierId], references: [id])
  warehouseId String    @map("warehouse_id")
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  status      DocStatus @default(DRAFT)
  note        String?
  createdById String    @map("created_by_id")
  createdBy   User      @relation("ReceiptCreatedBy", fields: [createdById], references: [id])
  receivedAt  DateTime? @map("received_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  items GoodsReceiptItem[]

  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id         String       @id @default(cuid())
  receiptId  String       @map("receipt_id")
  receipt    GoodsReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  productId  String       @map("product_id")
  product    Product      @relation(fields: [productId], references: [id])
  batchCode  String?      @map("batch_code")
  expiryDate DateTime?    @map("expiry_date")
  mfgDate    DateTime?    @map("mfg_date")
  quantity   Float
  unitCost   Float?       @map("unit_cost")

  @@map("goods_receipt_items")
}

// -----------------------------------------------------------------------------
// Xuất kho
// -----------------------------------------------------------------------------
enum IssueType {
  SALE // bán hàng
  INTERNAL_USE // dùng nội bộ / tiêu hao dịch vụ
  DISPOSAL // hủy (hết hạn / hỏng)
  ADJUSTMENT // điều chỉnh giảm
}

model GoodsIssue {
  id           String    @id @default(cuid())
  code         String    @unique // mã phiếu xuất PX-xxxx
  warehouseId  String    @map("warehouse_id")
  warehouse    Warehouse @relation(fields: [warehouseId], references: [id])
  issueType    IssueType @map("issue_type")
  customerName String?   @map("customer_name") // tên khách / bộ phận nhận
  status       DocStatus @default(DRAFT)
  note         String?
  createdById  String    @map("created_by_id")
  createdBy    User      @relation("IssueCreatedBy", fields: [createdById], references: [id])
  issuedAt     DateTime? @map("issued_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  items GoodsIssueItem[]

  @@map("goods_issues")
}

model GoodsIssueItem {
  id        String      @id @default(cuid())
  issueId   String      @map("issue_id")
  issue     GoodsIssue  @relation(fields: [issueId], references: [id], onDelete: Cascade)
  productId String      @map("product_id")
  product   Product     @relation(fields: [productId], references: [id])
  batchId   String?     @map("batch_id")
  batch     StockBatch? @relation(fields: [batchId], references: [id])
  quantity  Float

  @@map("goods_issue_items")
}

// -----------------------------------------------------------------------------
// Sổ cái biến động tồn (audit trail cho mọi thay đổi số lượng)
// -----------------------------------------------------------------------------
enum MovementType {
  INBOUND
  OUTBOUND
  ADJUSTMENT
}

model StockMovement {
  id          String       @id @default(cuid())
  productId   String       @map("product_id")
  product     Product      @relation(fields: [productId], references: [id])
  warehouseId String       @map("warehouse_id")
  warehouse   Warehouse    @relation(fields: [warehouseId], references: [id])
  batchId     String?      @map("batch_id")
  batch       StockBatch?  @relation(fields: [batchId], references: [id])
  type        MovementType
  quantity    Float // dương = nhập, âm = xuất
  refType     String?      @map("ref_type") // "RECEIPT" | "ISSUE"
  refId       String?      @map("ref_id")
  refCode     String?      @map("ref_code")
  note        String?
  createdAt   DateTime     @default(now()) @map("created_at")

  @@index([productId, warehouseId])
  @@index([createdAt])
  @@map("stock_movements")
}

// -----------------------------------------------------------------------------
// Nhật ký hệ thống (append-only)
// -----------------------------------------------------------------------------
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?  @map("user_id")
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  detail     String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}
