// =============================================================================
// Sophia Wellness — Quản lý kho
// Lõi nghiệp vụ: tồn kho theo LÔ + HẠN SỬ DỤNG (HSD), nhập/xuất kho, cảnh báo.
// Áp dụng cho 4 nhóm hàng: mỹ phẩm/skincare, thực phẩm chức năng,
// vật tư tiêu hao spa, thiết bị & máy.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// RBAC — người dùng / vai trò / quyền
// -----------------------------------------------------------------------------
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  roles         UserRole[]
  receipts      GoodsReceipt[]  @relation("ReceiptCreatedBy")
  issues        GoodsIssue[]     @relation("IssueCreatedBy")
  transfers     StockTransfer[]  @relation("TransferCreatedBy")
  serviceUsages ServiceUsage[]   @relation("ServicePerformedBy")
  stockCounts   StockCount[]     @relation("CountCreatedBy")
  maintenance   MaintenanceLog[] @relation("MaintenanceCreatedBy")
  shotLogs      ShotLog[]        @relation("ShotCreatedBy")
  auditLogs     AuditLog[]
  svcStockOpened  ServiceStockItem[] @relation("SvcStockOpenedBy")
  svcStockUpdated ServiceStockItem[] @relation("SvcStockUpdatedBy")

  @@map("users")
}

model Role {
  id          String           @id @default(cuid())
  code        String           @unique
  name        String
  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id    String           @id @default(cuid())
  code  String           @unique
  name  String
  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// -----------------------------------------------------------------------------
// Danh mục
// -----------------------------------------------------------------------------
model Warehouse {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  address   String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  batches       StockBatch[]
  receipts      GoodsReceipt[]
  issues        GoodsIssue[]
  movements     StockMovement[]
  transfersFrom StockTransfer[] @relation("TransferFrom")
  transfersTo   StockTransfer[] @relation("TransferTo")
  serviceUsages ServiceUsage[]
  stockCounts   StockCount[]
  assets        Asset[]
  serviceStock  ServiceStockItem[]

  @@map("warehouses")
}

model Supplier {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  contactPerson String?  @map("contact_person") // người liên hệ
  phone         String?
  email         String?
  address       String?
  taxCode       String?  @map("tax_code")
  note          String?
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")

  receipts GoodsReceipt[]
  batches  StockBatch[]
  assets   Asset[]

  @@map("suppliers")
}

// Nhóm hàng: mỹ phẩm/skincare, TPCN, vật tư tiêu hao, thiết bị...
model Category {
  id        String    @id @default(cuid())
  code      String    @unique
  name      String
  note      String?
  // Hạn dùng tối đa sau khi mở nắp (PAO) tính theo tháng — vd Serum 6, Kem/Mặt nạ 12.
  // HSD thực tế = min(HSD trên bao bì, ngày mở nắp + openMaxMonths).
  openMaxMonths   Int?     @map("open_max_months")
  // Cảnh báo tồn lâu mà CHƯA mở nắp: số tháng kể từ ngày mua.
  storeWarnMonths Int?     @map("store_warn_months")
  createdAt DateTime  @default(now()) @map("created_at")
  products  Product[]

  @@map("categories")
}

// Thương hiệu (chọn từ danh sách khi khai báo sản phẩm)
model Brand {
  id        String   @id @default(cuid())
  name      String   @unique
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("brands")
}

// Chế độ quản lý tồn:
//  - LOT: quản lý theo lô (bắt buộc mã lô khi nhập), có thể có HSD.
//  - QUANTITY: chỉ đếm số lượng (vật tư/thiết bị không cần lô).
enum TrackingMode {
  LOT
  QUANTITY
}

model Product {
  id              String       @id @default(cuid())
  sku             String       @unique
  barcode         String?      @unique
  name            String
  brand           String?
  categoryId      String?      @map("category_id")
  category        Category?    @relation(fields: [categoryId], references: [id])
  trackingMode    TrackingMode @default(LOT) @map("tracking_mode")
  // Bắt buộc nhập HSD khi nhận hàng (mỹ phẩm, TPCN thường = true).
  requiresExpiry  Boolean      @default(false) @map("requires_expiry")
  uom             String       @default("Cái") // đơn vị tính
  minStock        Float?       @map("min_stock") // định mức tồn tối thiểu
  isTester        Boolean      @default(false) @map("is_tester") // hàng test/tester
  // Số ngày trước HSD bắt đầu cảnh báo; null = dùng mặc định hệ thống (60).
  expiryAlertDays Int?         @map("expiry_alert_days")
  // Mốc thời gian khai báo ở cấp sản phẩm (theo góp ý demo). Ngày mở nắp phục vụ
  // theo dõi mỹ phẩm sau khi mở; hệ thống tự tính số ngày còn lại tới HSD.
  purchaseDate    DateTime?    @map("purchase_date")   // ngày mua
  openedDate      DateTime?    @map("opened_date")     // ngày mở nắp
  expiryDate      DateTime?    @map("expiry_date")     // hạn sử dụng
  note            String?
  isActive        Boolean      @default(true) @map("is_active")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  batches      StockBatch[]
  receiptItems GoodsReceiptItem[]
  issueItems   GoodsIssueItem[]
  movements       StockMovement[]
  serviceItems    ServiceItem[]
  transferItems   StockTransferItem[]
  stockCountItems StockCountItem[]
  assets          Asset[]
  serviceStock    ServiceStockItem[]

  @@map("products")
}

// -----------------------------------------------------------------------------
// Tồn kho — mỗi lô (batch) là một đơn vị tồn của 1 sản phẩm tại 1 kho.
// Sản phẩm QUANTITY dùng 1 lô "không mã / không HSD" gộp chung.
// -----------------------------------------------------------------------------
model StockBatch {
  id          String    @id @default(cuid())
  productId   String    @map("product_id")
  product     Product   @relation(fields: [productId], references: [id])
  warehouseId String    @map("warehouse_id")
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  batchCode   String?   @map("batch_code") // mã lô/số lô (null với QUANTITY)
  expiryDate  DateTime? @map("expiry_date") // HSD
  mfgDate     DateTime? @map("mfg_date")    // ngày sản xuất
  quantity    Float     @default(0) // tồn hiện tại của lô
  unitCost    Float?    @map("unit_cost") // giá vốn / đơn vị
  supplierId  String?   @map("supplier_id")
  supplier    Supplier? @relation(fields: [supplierId], references: [id])
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  movements  StockMovement[]
  issueItems GoodsIssueItem[]
  countItems StockCountItem[]

  @@index([productId, warehouseId])
  @@index([expiryDate])
  @@map("stock_batches")
}

// -----------------------------------------------------------------------------
// Nhập kho
// -----------------------------------------------------------------------------
enum DocStatus {
  DRAFT
  POSTED
  CANCELLED
}

model GoodsReceipt {
  id          String    @id @default(cuid())
  code        String    @unique // mã phiếu nhập PN-xxxx
  supplierId  String    @map("supplier_id")
  supplier    Supplier  @relation(fields: [supplierId], references: [id])
  warehouseId String    @map("warehouse_id")
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  status       DocStatus @default(DRAFT)
  note         String?
  createdById  String    @map("created_by_id")
  createdBy    User      @relation("ReceiptCreatedBy", fields: [createdById], references: [id])
  receivedAt   DateTime? @map("received_at")
  cancelReason String?   @map("cancel_reason") // lý do hủy/sửa (bắt buộc khi hủy)
  cancelledAt  DateTime? @map("cancelled_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  items GoodsReceiptItem[]

  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id         String       @id @default(cuid())
  receiptId  String       @map("receipt_id")
  receipt    GoodsReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  productId  String       @map("product_id")
  product    Product      @relation(fields: [productId], references: [id])
  batchCode  String?      @map("batch_code")
  expiryDate DateTime?    @map("expiry_date")
  mfgDate    DateTime?    @map("mfg_date")
  quantity   Float
  unitCost   Float?       @map("unit_cost")

  @@map("goods_receipt_items")
}

// -----------------------------------------------------------------------------
// Xuất kho
// -----------------------------------------------------------------------------
enum IssueType {
  SALE // bán hàng
  INTERNAL_USE // dùng nội bộ / tiêu hao dịch vụ
  DISPOSAL // hủy (hết hạn / hỏng)
  ADJUSTMENT // điều chỉnh giảm
}

model GoodsIssue {
  id           String    @id @default(cuid())
  code         String    @unique // mã phiếu xuất PX-xxxx
  warehouseId  String    @map("warehouse_id")
  warehouse    Warehouse @relation(fields: [warehouseId], references: [id])
  issueType    IssueType @map("issue_type")
  customerName String?   @map("customer_name") // tên khách / bộ phận nhận
  status       DocStatus @default(DRAFT)
  note         String?
  createdById  String    @map("created_by_id")
  createdBy    User      @relation("IssueCreatedBy", fields: [createdById], references: [id])
  issuedAt     DateTime? @map("issued_at")
  cancelReason String?   @map("cancel_reason") // lý do hủy/sửa (bắt buộc khi hủy)
  cancelledAt  DateTime? @map("cancelled_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  items GoodsIssueItem[]

  @@map("goods_issues")
}

model GoodsIssueItem {
  id        String      @id @default(cuid())
  issueId   String      @map("issue_id")
  issue     GoodsIssue  @relation(fields: [issueId], references: [id], onDelete: Cascade)
  productId String      @map("product_id")
  product   Product     @relation(fields: [productId], references: [id])
  batchId   String?     @map("batch_id")
  batch     StockBatch? @relation(fields: [batchId], references: [id])
  quantity  Float

  @@map("goods_issue_items")
}

// -----------------------------------------------------------------------------
// Sổ cái biến động tồn (audit trail cho mọi thay đổi số lượng)
// -----------------------------------------------------------------------------
enum MovementType {
  INBOUND
  OUTBOUND
  ADJUSTMENT
}

model StockMovement {
  id          String       @id @default(cuid())
  productId   String       @map("product_id")
  product     Product      @relation(fields: [productId], references: [id])
  warehouseId String       @map("warehouse_id")
  warehouse   Warehouse    @relation(fields: [warehouseId], references: [id])
  batchId     String?      @map("batch_id")
  batch       StockBatch?  @relation(fields: [batchId], references: [id])
  type        MovementType
  quantity    Float // dương = nhập, âm = xuất
  refType     String?      @map("ref_type") // "RECEIPT" | "ISSUE"
  refId       String?      @map("ref_id")
  refCode     String?      @map("ref_code")
  note        String?
  createdAt   DateTime     @default(now()) @map("created_at")

  @@index([productId, warehouseId])
  @@index([createdAt])
  @@map("stock_movements")
}

// -----------------------------------------------------------------------------
// Chuyển kho giữa các chi nhánh
// -----------------------------------------------------------------------------
model StockTransfer {
  id              String    @id @default(cuid())
  code            String    @unique // mã phiếu chuyển PC-xxxx
  fromWarehouseId String    @map("from_warehouse_id")
  fromWarehouse   Warehouse @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouseId   String    @map("to_warehouse_id")
  toWarehouse     Warehouse @relation("TransferTo", fields: [toWarehouseId], references: [id])
  status          DocStatus @default(DRAFT)
  note            String?
  createdById     String    @map("created_by_id")
  createdBy       User      @relation("TransferCreatedBy", fields: [createdById], references: [id])
  transferredAt   DateTime? @map("transferred_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  items StockTransferItem[]

  @@map("stock_transfers")
}

model StockTransferItem {
  id         String        @id @default(cuid())
  transferId String        @map("transfer_id")
  transfer   StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  productId  String        @map("product_id")
  product    Product       @relation(fields: [productId], references: [id])
  quantity   Float

  @@map("stock_transfer_items")
}

// -----------------------------------------------------------------------------
// Dịch vụ / liệu trình + định mức tiêu hao (BOM) và ghi nhận sử dụng
// -----------------------------------------------------------------------------
model Service {
  id        String         @id @default(cuid())
  code      String         @unique
  name      String
  price     Float?         @map("price") // đơn giá dịch vụ / 1 lượt
  note      String?
  isActive  Boolean        @default(true) @map("is_active")
  createdAt DateTime       @default(now()) @map("created_at")
  items     ServiceItem[]
  usages    ServiceUsage[]

  @@map("services")
}

// Định mức tiêu hao 1 lượt dịch vụ: mỗi sản phẩm tiêu hao bao nhiêu.
model ServiceItem {
  id        String  @id @default(cuid())
  serviceId String  @map("service_id")
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id])
  quantity  Float

  @@unique([serviceId, productId])
  @@map("service_items")
}

// Một lần thực hiện dịch vụ N lượt -> tự trừ kho (tạo phiếu xuất INTERNAL_USE).
model ServiceUsage {
  id            String    @id @default(cuid())
  code          String    @unique // mã SV-xxxx
  serviceId     String    @map("service_id")
  service       Service   @relation(fields: [serviceId], references: [id])
  warehouseId   String    @map("warehouse_id")
  warehouse     Warehouse @relation(fields: [warehouseId], references: [id])
  sessions      Int       @default(1) // số lượt
  customerName  String?   @map("customer_name")
  revenue       Float?    @map("revenue") // doanh thu = đơn giá × số lượt (chốt tại thời điểm ghi nhận)
  cost          Float?    @map("cost") // giá vốn vật tư tiêu hao
  note          String?
  issueId       String?   @map("issue_id") // phiếu xuất phát sinh
  issueCode     String?   @map("issue_code")
  performedById String    @map("performed_by_id")
  performedBy   User      @relation("ServicePerformedBy", fields: [performedById], references: [id])
  performedAt   DateTime  @default(now()) @map("performed_at")

  @@map("service_usages")
}

// -----------------------------------------------------------------------------
// Tài sản / thiết bị theo serial + bảo hành
// -----------------------------------------------------------------------------
enum AssetStatus {
  IN_STOCK // trong kho
  IN_USE // đang sử dụng
  MAINTENANCE // bảo trì/sửa chữa
  RETIRED // thanh lý
}

enum DepreciationMethod {
  STRAIGHT_LINE // đường thẳng
  DECLINING     // số dư giảm dần (ước tính)
}

model Asset {
  id            String      @id @default(cuid())
  code          String      @unique // mã tài sản
  productId     String      @map("product_id")
  product       Product     @relation(fields: [productId], references: [id])
  serialNumber  String?     @unique @map("serial_number")
  warehouseId   String?     @map("warehouse_id")
  warehouse     Warehouse?  @relation(fields: [warehouseId], references: [id])
  status        AssetStatus @default(IN_STOCK)
  location      String? // vị trí đặt (phòng/chi nhánh)
  purchaseDate  DateTime?   @map("purchase_date")
  warrantyUntil DateTime?   @map("warranty_until")
  supplierId    String?     @map("supplier_id")
  supplier      Supplier?   @relation(fields: [supplierId], references: [id])
  note          String?

  // (a) Khấu hao
  cost               Float?              @map("cost")               // nguyên giá
  salvageValue       Float?              @map("salvage_value")      // giá trị thu hồi ước tính (mặc định 0)
  depreciationStart  DateTime?           @map("depreciation_start") // ngày bắt đầu tính khấu hao
  depreciationMonths Int?                @map("depreciation_months") // thời gian khấu hao (tháng)
  depreciationMethod DepreciationMethod? @map("depreciation_method")

  // (b) Bảo hành – bảo trì
  warrantyVendor         String? @map("warranty_vendor")          // đơn vị/hãng bảo hành
  warrantyMonths         Int?    @map("warranty_months")          // thời gian bảo hành (tháng)
  maintenanceCycleMonths Int?    @map("maintenance_cycle_months") // chu kỳ bảo trì định kỳ (tháng)

  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  maintenance MaintenanceLog[]
  handpieces  Handpiece[]

  @@index([status])
  @@index([warrantyUntil])
  @@map("assets")
}

// -----------------------------------------------------------------------------
// Tay cầm / vật tư theo máy đếm theo shot tiêu hao: mỗi tay cầm gắn với 1 máy,
// có định mức shot tối đa + số shot đã dùng; cảnh báo khi gần hết để thay mới.
// -----------------------------------------------------------------------------
enum HandpieceStatus {
  ACTIVE // đang dùng
  RETIRED // đã thay/loại bỏ
}

model Handpiece {
  id        String          @id @default(cuid())
  code      String          @unique // mã tay cầm TC-xxxx
  name      String // tên tay cầm (VD: Tay cầm HIFU 4.5mm)
  assetId   String?         @map("asset_id") // máy gắn tay cầm (tùy chọn)
  asset     Asset?          @relation(fields: [assetId], references: [id])
  machine   String? // tên máy nhập tay (khi không chọn tài sản cụ thể)
  maxShots  Int             @map("max_shots") // định mức shot tối đa
  usedShots Int             @default(0) @map("used_shots") // số shot đã dùng
  warnShots Int             @default(1000) @map("warn_shots") // cảnh báo khi số shot còn lại <= giá trị này
  status    HandpieceStatus @default(ACTIVE)
  note      String?
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  shotLogs ShotLog[]

  @@index([status])
  @@map("handpieces")
}

model ShotLog {
  id           String    @id @default(cuid())
  handpieceId  String    @map("handpiece_id")
  handpiece    Handpiece @relation(fields: [handpieceId], references: [id])
  shots        Int // số shot bắn trong lần ghi nhận
  customerName String?   @map("customer_name")
  note         String?
  performedAt  DateTime  @default(now()) @map("performed_at")
  createdById  String    @map("created_by_id")
  createdBy    User      @relation("ShotCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([handpieceId])
  @@map("shot_logs")
}

// -----------------------------------------------------------------------------
// Kiểm kê định kỳ: chốt tồn hệ thống theo lô, nhập số thực đếm, ghi bút toán
// điều chỉnh chênh lệch khi duyệt.
// -----------------------------------------------------------------------------
model StockCount {
  id          String    @id @default(cuid())
  code        String    @unique // mã phiếu kiểm kê PK-xxxx
  warehouseId String    @map("warehouse_id")
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  status      DocStatus @default(DRAFT)
  note        String?
  createdById String    @map("created_by_id")
  createdBy   User      @relation("CountCreatedBy", fields: [createdById], references: [id])
  countedAt   DateTime? @map("counted_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  items StockCountItem[]

  @@map("stock_counts")
}

model StockCountItem {
  id         String     @id @default(cuid())
  countId    String     @map("count_id")
  count      StockCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  productId  String     @map("product_id")
  product    Product    @relation(fields: [productId], references: [id])
  batchId    String     @map("batch_id")
  batch      StockBatch @relation(fields: [batchId], references: [id])
  systemQty  Float      @map("system_qty") // tồn hệ thống lúc chốt phiếu
  countedQty Float?     @map("counted_qty") // số thực đếm

  @@map("stock_count_items")
}

// -----------------------------------------------------------------------------
// Lịch sử bảo trì / sửa chữa thiết bị
// -----------------------------------------------------------------------------
enum MaintenanceType {
  MAINTENANCE // bảo trì định kỳ
  REPAIR // sửa chữa
  INSPECTION // kiểm tra
}

model MaintenanceLog {
  id          String          @id @default(cuid())
  assetId     String          @map("asset_id")
  asset       Asset           @relation(fields: [assetId], references: [id], onDelete: Cascade)
  type        MaintenanceType @default(MAINTENANCE)
  description String
  cost        Float?
  vendor      String? // đơn vị/kỹ thuật thực hiện
  performedAt DateTime        @map("performed_at")
  note        String?
  createdById String          @map("created_by_id")
  createdBy   User            @relation("MaintenanceCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime        @default(now()) @map("created_at")

  @@index([assetId])
  @@map("maintenance_logs")
}

// -----------------------------------------------------------------------------
// Cấu hình công ty / thương hiệu (1 bản ghi duy nhất, id = "company")
// -----------------------------------------------------------------------------
model CompanySetting {
  id        String   @id @default("company")
  name      String   @default("Sophia Wellness")
  logo      String? // ảnh logo dạng data URI (base64)
  address   String?
  phone     String?
  email     String?
  taxCode   String?  @map("tax_code")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("company_settings")
}

// -----------------------------------------------------------------------------
// Nhật ký hệ thống (append-only)
// -----------------------------------------------------------------------------
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?  @map("user_id")
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  detail     String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}

// -----------------------------------------------------------------------------
// Kho Dịch Vụ — theo dõi hàng đã MỞ NẮP đang dùng dở cho dịch vụ. Mỗi bản ghi =
// 1 hộp/chai đã mở của 1 sản phẩm: còn lại bao nhiêu, HSD sau mở, ai mở/cập nhật.
// Tự sinh/cập nhật khi Ghi nhận dịch vụ (chỉ với hàng requiresExpiry = mở nắp).
// -----------------------------------------------------------------------------
enum ServiceStockStatus {
  IN_USE // đang sử dụng
  EMPTY  // đã hết
}

model ServiceStockItem {
  id           String             @id @default(cuid())
  productId    String             @map("product_id")
  product      Product            @relation(fields: [productId], references: [id])
  warehouseId  String?            @map("warehouse_id")
  warehouse    Warehouse?         @relation(fields: [warehouseId], references: [id])
  openedDate   DateTime           @map("opened_date")          // ngày mở nắp
  expiryDate   DateTime?          @map("expiry_date")          // HSD sau mở = ngày mở + PAO nhóm
  initialQty   Float              @default(1) @map("initial_qty") // dung tích/số lượng khi mở (mặc định 1 đơn vị)
  remainingQty Float              @map("remaining_qty")        // còn lại sau khi trừ định mức
  status       ServiceStockStatus @default(IN_USE)
  openedById   String             @map("opened_by_id")
  openedBy     User               @relation("SvcStockOpenedBy", fields: [openedById], references: [id])
  updatedById  String?            @map("updated_by_id")
  updatedBy    User?              @relation("SvcStockUpdatedBy", fields: [updatedById], references: [id])
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  @@index([productId, status])
  @@map("service_stock_items")
}
