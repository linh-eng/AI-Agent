// =============================================================================
// THNG — Hệ thống quản lý kho (Nhập / Xuất / Lắp ráp / Tháo dỡ / Truy vết Serial)
// Prisma schema — bao phủ toàn bộ mục 6 của bản mô tả yêu cầu.
//
// Nguyên tắc bất biến được mã hóa trong schema:
//   * warehouse_id BẮT BUỘC trên mọi bản ghi tồn (Serial, Lot, StockMovement).
//   * Serial không bao giờ bị xóa cứng — chỉ đổi `status`; serial bị thay
//     trỏ tới `replacedBySerialId`; máy lắp ráp trỏ con qua `parentSerialId`.
//   * bom_as_built có `version` (nhiều phiên bản cho một serial cha).
//   * Warehouse.countsAsAvailable phân biệt kho tính/không tính tồn khả dụng.
//   * Chứng từ đã duyệt không sửa/xóa — chỉ đối ứng bằng chứng từ khác.
//   * AuditLog append-only (không có API sửa/xóa).
//
// Ràng buộc "supplier_id/project_id NOT NULL HOẶC is_commercial_stock":
//   Prisma không hỗ trợ CHECK constraint trong schema. Trên InboundLine,
//   `supplierId` là quan hệ BẮT BUỘC (NOT NULL ở DB). Điều kiện
//   "projectId khác null HOẶC isCommercialStock = true" được kiểm ở tầng API
//   (src/lib/validation) + có thể bổ sung CHECK constraint qua migration SQL.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// ENUMS
// ----------------------------------------------------------------------------

/// Chế độ quản lý hàng hóa (mục 3c)
enum TrackingMode {
  SERIAL // Laptop, màn hình, thiết bị mạng... quét 100%, unique toàn hệ thống
  LOT // Mực in, linh kiện có mã lô — ghi lô + số lượng + hạn
  QUANTITY // Cáp, ốc, keo, phụ kiện nhỏ — đếm số lượng
  LICENSE // Windows, Office, phần mềm bản quyền — mã key + hạn
}

/// Vòng đời serial (mục 3d) — chỉ chuyển trạng thái, không xóa
enum SerialStatus {
  IN_STOCK
  WIP
  RESERVED
  SOLD
  RENTED
  IN_WARRANTY_INTAKE
  AT_VENDOR
  IN_REPAIR
  DAMAGED
  REPLACED
  DISASSEMBLED
  SCRAPPED
}

/// Grade tình trạng cho hàng tháo máy / tân trang
enum ConditionGrade {
  A
  B
  C
}

/// Loại đối tác
enum PartnerType {
  SUPPLIER // Nhà cung cấp
  CUSTOMER // Khách hàng
  BOTH
}

/// Bên bảo hành
enum WarrantyProvider {
  VENDOR // NCC / hãng
  THNG // Bảo hành THNG cấp cho khách
}

/// Trạng thái duyệt chứng từ
enum DocumentStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
}

/// Loại nghiệp vụ NHẬP (mục 5, M1)
enum InboundType {
  N1 // Mua mới -> K-TM
  N2 // Hàng dự án -> K-DA
  N3 // Bảo hành từ khách -> K-BH-KH
  N4 // Bảo hành NCC/hãng trả về -> K-BH-KH
  N5 // Sửa chữa có phí -> K-SC
  N6 // Thiết bị hư hỏng -> K-HH
  N7 // Thành phẩm sau lắp ráp
  N8 // Linh kiện sau tháo dỡ -> K-TMAY
  N9 // Khách trả/đổi
  N10 // Thu hồi demo/thuê
  N11 // Chuyển kho
  N12 // Khuyến mãi/hàng mượn NCC
}

/// Loại nghiệp vụ XUẤT (mục 5, M1)
enum OutboundType {
  X1 // Bán thương mại
  X2 // Giao hàng dự án
  X3 // Xuất linh kiện lắp ráp
  X4 // Gửi bảo hành hãng (K-BH-KH -> K-BH-NCC)
  X5 // Trả máy BH cho khách
  X6 // Trả máy sửa chữa
  X7 // Trả hàng lỗi NCC
  X8 // Demo/mượn/thuê
  X9 // Chuyển kho
  X10 // Hủy/thanh lý
  X11 // Điều chỉnh kiểm kê
}

/// Loại biến động tồn
enum MovementType {
  INBOUND
  OUTBOUND
  TRANSFER
  ADJUSTMENT
  ASSEMBLY_CONSUME // linh kiện -> WIP
  ASSEMBLY_PRODUCE // thành phẩm nhập kho
  DISASSEMBLY
}

/// Chế độ lệnh lắp ráp
enum WorkOrderMode {
  TO_ORDER // lắp theo đơn
  TO_STOCK // lắp để tồn kho
}

enum WorkOrderStatus {
  DRAFT
  ALLOCATING // đang cấp phát linh kiện
  ASSEMBLING
  QC
  DONE
  CANCELLED
}

enum QcType {
  INBOUND // QC đầu vào (M2)
  OUTPUT // QC/burn-in đầu ra (M4)
}

enum QcResult {
  PASS
  FAIL
}

enum StockCountStatus {
  DRAFT
  COUNTING
  PENDING_APPROVAL
  APPROVED
  CANCELLED
}

/// Hướng xử lý thiết bị hư hỏng (K-HH)
enum DamageResolution {
  PENDING
  RETURN_VENDOR // trả NCC (X7)
  CUSTOMER_COMPENSATION // thu bồi thường khách
  SALVAGE_PARTS // tận dụng linh kiện (M10)
  LIQUIDATE // thanh lý
}

// ----------------------------------------------------------------------------
// AUTH & RBAC
// ----------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  roles     UserRole[]
  auditLogs AuditLog[]

  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  code        String   @unique // ADMIN, BOD, PURCHASING, WH_ACCOUNTANT, WAREHOUSE_KEEPER, TECH, QC, SALES, WARRANTY
  name        String
  description String?
  createdAt   DateTime @default(now())

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique // vd: "warehouse.read", "product.write", "outbound.approve"
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ----------------------------------------------------------------------------
// DANH MỤC KHO / VỊ TRÍ (A1)
// ----------------------------------------------------------------------------

model Warehouse {
  id                String   @id @default(cuid())
  code              String   @unique // K-TM, K-DA, K-TAM, K-BH-KH, K-BH-NCC, K-SC, K-HH, K-LK, K-TMAY, K-DEMO, K-SW, K-TL
  name              String
  description       String?
  /// K-HH, K-BH-KH, K-BH-NCC, K-SC, K-TL => false (không tính tồn khả dụng bán)
  countsAsAvailable Boolean  @default(true)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())

  zones         Zone[]
  serials       Serial[]
  lots          Lot[]
  movementsFrom StockMovement[] @relation("MovementFromWarehouse")
  movementsTo   StockMovement[] @relation("MovementToWarehouse")

  @@map("warehouses")
}

model Zone {
  id          String    @id @default(cuid())
  warehouseId String
  code        String
  name        String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  bins        Bin[]

  @@unique([warehouseId, code])
  @@map("zones")
}

model Bin {
  id      String   @id @default(cuid())
  zoneId  String
  code    String
  label   String?
  zone    Zone     @relation(fields: [zoneId], references: [id])
  serials Serial[]

  @@unique([zoneId, code])
  @@map("bins")
}

// ----------------------------------------------------------------------------
// DỰ ÁN / ĐỐI TÁC / SẢN PHẨM
// (dùng chung với Module Hỗ trợ — chia sẻ bảng projects, partners, serials)
// ----------------------------------------------------------------------------

model Project {
  id         String    @id @default(cuid())
  code       String    @unique
  name       String
  customerId String?
  customerPo String? // PO của khách
  contractNo String? // Hợp đồng mua bán
  status     String    @default("ACTIVE") // ACTIVE, ACCEPTED, CLOSED...
  acceptedAt DateTime? // mốc nghiệm thu (dùng cho SLA tồn K-DA 30 ngày)
  createdAt  DateTime  @default(now())

  customer       Partner?        @relation("ProjectCustomer", fields: [customerId], references: [id])
  serials        Serial[]
  lots           Lot[]
  inboundLines   InboundLine[]
  outboundLines  OutboundLine[]
  outboundOrders OutboundOrder[]

  @@map("projects")
}

model Partner {
  id          String      @id @default(cuid())
  code        String      @unique
  name        String
  type        PartnerType
  taxCode     String?
  phone       String?
  email       String?
  address     String?
  /// Hạn mức công nợ (VND) — kế toán kiểm tra khi duyệt xuất
  creditLimit Decimal?    @db.Decimal(18, 2)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())

  projectsAsCustomer Project[]       @relation("ProjectCustomer")
  serialsAsSupplier  Serial[]        @relation("SerialSupplier")
  lotsAsSupplier     Lot[]           @relation("LotSupplier")
  inboundOrders      InboundOrder[]
  outboundOrders     OutboundOrder[]
  origins            Origin[]

  @@map("partners")
}

model Product {
  id           String       @id @default(cuid())
  sku          String       @unique
  barcode      String?      @unique
  name         String
  model        String?
  brand        String?
  category     String?
  trackingMode TrackingMode
  uom          String       @default("Cái") // đơn vị tính
  weight       Decimal?     @db.Decimal(12, 3)
  dimensions   String? // DxRxC
  /// Tồn tối thiểu để cảnh báo (đặc biệt cho linh kiện K-LK)
  minStock     Int?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())

  serials       Serial[]
  lots          Lot[]
  licenses      License[]
  bomPlanned    BomPlanned[]
  inboundLines  InboundLine[]
  outboundLines OutboundLine[]
  workOrders    WorkOrder[]

  @@map("products")
}

// ----------------------------------------------------------------------------
// SERIAL — trung tâm truy vết. Bất biến, tự tham chiếu cha/con và replaced_by.
// ----------------------------------------------------------------------------

model Serial {
  id           String          @id @default(cuid())
  serialNumber String          @unique // serial/imei — unique toàn hệ thống
  productId    String
  /// BẮT BUỘC: mọi serial luôn thuộc đúng một kho
  warehouseId  String
  status       SerialStatus    @default(IN_STOCK)
  condition    String? // mô tả tình trạng
  grade        ConditionGrade?

  // Xuất xứ nghiệp vụ (mục 3b) — supplier/project gắn khi nhập
  supplierId        String?
  projectId         String?
  /// true nếu là hàng tồn thương mại chưa gán dự án
  isCommercialStock Boolean  @default(false)
  poNumber          String?
  invoiceNumber     String?
  yearOfManufacture Int?
  originCountry     String?
  weight            Decimal? @db.Decimal(12, 3)
  dimensions        String?

  binId String?

  // Quan hệ cha–con & thay thế (mục 3d) — TỰ THAM CHIẾU
  parentSerialId     String?
  replacedBySerialId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  supplier  Partner?  @relation("SerialSupplier", fields: [supplierId], references: [id])
  project   Project?  @relation(fields: [projectId], references: [id])
  bin       Bin?      @relation(fields: [binId], references: [id])

  // Cha–con: một serial cha có nhiều serial con; mỗi con trỏ về 1 cha
  parentSerial Serial?  @relation("SerialParentChild", fields: [parentSerialId], references: [id])
  childSerials Serial[] @relation("SerialParentChild")

  // Thay thế: serial cũ -> serial mới (1-1)
  replacedBy Serial? @relation("SerialReplacement", fields: [replacedBySerialId], references: [id])
  replaces   Serial? @relation("SerialReplacement")

  origins            Origin[]
  warranties         Warranty[]
  events             SerialEvent[]
  bomAsBuiltAsParent BomAsBuilt[]    @relation("BomAsBuiltParent")
  bomAsBuiltAsChild  BomAsBuilt[]    @relation("BomAsBuiltChild")
  activatedLicenses  License[]
  movements          StockMovement[]

  @@index([productId])
  @@index([warehouseId])
  @@index([status])
  @@index([projectId])
  @@index([parentSerialId])
  @@map("serials")
}

model Lot {
  id                String    @id @default(cuid())
  lotNumber         String
  productId         String
  warehouseId       String // BẮT BUỘC
  manufactureDate   DateTime?
  expiryDate        DateTime?
  quantity          Int       @default(0)
  /// Số lượng đang bị GIỮ bởi các phiếu (reservation) — available = quantity - reservedQty
  reservedQty       Int       @default(0)
  supplierId        String?
  projectId         String?
  isCommercialStock Boolean   @default(false)
  createdAt         DateTime  @default(now())

  product          Product           @relation(fields: [productId], references: [id])
  warehouse        Warehouse         @relation(fields: [warehouseId], references: [id])
  supplier         Partner?          @relation("LotSupplier", fields: [supplierId], references: [id])
  project          Project?          @relation(fields: [projectId], references: [id])
  origins          Origin[]
  warranties       Warranty[]
  sessionMaterials SessionMaterial[]

  @@unique([productId, lotNumber, warehouseId])
  @@index([productId])
  @@index([warehouseId])
  @@map("lots")
}

model Origin {
  id                   String   @id @default(cuid())
  // Gắn với serial HOẶC lot (một trong hai)
  serialId             String?
  lotId                String?
  countryOfOrigin      String?
  supplierId           String?
  poNumber             String?
  coNumber             String? // CO — Certificate of Origin
  cqNumber             String? // CQ — Certificate of Quality
  customsDeclarationNo String? // số tờ khai hải quan
  createdAt            DateTime @default(now())

  serial   Serial?  @relation(fields: [serialId], references: [id])
  lot      Lot?     @relation(fields: [lotId], references: [id])
  supplier Partner? @relation(fields: [supplierId], references: [id])

  @@index([serialId])
  @@index([lotId])
  @@map("origins")
}

model Warranty {
  id        String           @id @default(cuid())
  serialId  String?
  lotId     String?
  provider  WarrantyProvider // NCC(VENDOR) hoặc THNG
  startDate DateTime?
  endDate   DateTime?
  terms     String?
  createdAt DateTime         @default(now())

  serial Serial? @relation(fields: [serialId], references: [id])
  lot    Lot?    @relation(fields: [lotId], references: [id])

  @@index([serialId])
  @@index([endDate])
  @@map("warranties")
}

model License {
  id                String    @id @default(cuid())
  productId         String
  licenseKey        String    @unique
  expiryDate        DateTime?
  activatedSerialId String? // thiết bị đã kích hoạt
  createdAt         DateTime  @default(now())

  product         Product @relation(fields: [productId], references: [id])
  activatedSerial Serial? @relation(fields: [activatedSerialId], references: [id])

  @@map("licenses")
}

// ----------------------------------------------------------------------------
// CHỨNG TỪ & ĐƠN NHẬP/XUẤT
// ----------------------------------------------------------------------------

model Document {
  id          String         @id @default(cuid())
  type        String // loại chứng từ
  number      String         @unique
  status      DocumentStatus @default(DRAFT)
  fileUrl     String?
  note        String?
  createdById String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@map("documents")
}

model InboundOrder {
  id                     String         @id @default(cuid())
  number                 String         @unique
  type                   InboundType
  supplierId             String?
  poNumber               String?
  invoiceNumber          String?
  destinationWarehouseId String?
  status                 DocumentStatus @default(DRAFT)
  note                   String?
  createdAt              DateTime       @default(now())

  supplier Partner?      @relation(fields: [supplierId], references: [id])
  lines    InboundLine[]

  @@map("inbound_orders")
}

model InboundLine {
  id                String  @id @default(cuid())
  inboundOrderId    String
  productId         String
  /// BẮT BUỘC ở tầng nghiệp vụ (mục 3b)
  supplierId        String
  /// projectId khác null HOẶC isCommercialStock = true (kiểm ở API)
  projectId         String?
  isCommercialStock Boolean @default(false)
  quantity          Int
  yearOfManufacture Int?
  originCountry     String?

  inboundOrder InboundOrder @relation(fields: [inboundOrderId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id])
  project      Project?     @relation(fields: [projectId], references: [id])

  @@index([inboundOrderId])
  @@map("inbound_lines")
}

model OutboundOrder {
  id           String         @id @default(cuid())
  number       String         @unique
  type         OutboundType
  customerId   String?
  projectId    String?
  status       DocumentStatus @default(DRAFT)
  approvedBy   String?
  approvedAt   DateTime?
  rejectReason String?
  deliveredAt  DateTime?
  note         String?
  createdAt    DateTime       @default(now())

  customer        Partner?         @relation(fields: [customerId], references: [id])
  project         Project?         @relation(fields: [projectId], references: [id])
  lines           OutboundLine[]
  deliveryReports DeliveryReport[]

  @@map("outbound_orders")
}

model OutboundLine {
  id              String  @id @default(cuid())
  outboundOrderId String
  productId       String
  projectId       String?
  quantity        Int

  outboundOrder OutboundOrder @relation(fields: [outboundOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])
  project       Project?      @relation(fields: [projectId], references: [id])

  @@index([outboundOrderId])
  @@map("outbound_lines")
}

// ----------------------------------------------------------------------------
// LẮP RÁP & BOM (M4)
// ----------------------------------------------------------------------------

model WorkOrder {
  id          String          @id @default(cuid())
  number      String          @unique
  mode        WorkOrderMode
  status      WorkOrderStatus @default(DRAFT)
  productId   String? // sản phẩm thành phẩm dự kiến
  assembledBy String? // người lắp
  startedAt   DateTime?
  finishedAt  DateTime?
  note        String?
  createdAt   DateTime        @default(now())

  product    Product?     @relation(fields: [productId], references: [id])
  bomPlanned BomPlanned[]
  bomAsBuilt BomAsBuilt[]
  qcReports  QcReport[]

  @@map("work_orders")
}

model BomPlanned {
  id          String @id @default(cuid())
  workOrderId String
  productId   String // linh kiện dự kiến
  quantity    Int

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])

  @@index([workOrderId])
  @@map("bom_planned")
}

/// As-built BOM có VERSION — liên kết serial cha ↔ serial/lot/license con
model BomAsBuilt {
  id             String   @id @default(cuid())
  workOrderId    String?
  parentSerialId String
  version        Int      @default(1)
  childSerialId  String?
  childLotId     String?
  childLicenseId String?
  quantity       Int      @default(1)
  note           String?
  createdAt      DateTime @default(now())

  workOrder    WorkOrder? @relation(fields: [workOrderId], references: [id])
  parentSerial Serial     @relation("BomAsBuiltParent", fields: [parentSerialId], references: [id])
  childSerial  Serial?    @relation("BomAsBuiltChild", fields: [childSerialId], references: [id])

  @@index([parentSerialId])
  @@index([parentSerialId, version])
  @@map("bom_as_built")
}

model QcReport {
  id          String   @id @default(cuid())
  workOrderId String?
  serialId    String?
  type        QcType
  result      QcResult
  burnInHours Int?
  details     Json?
  photos      String? // link ảnh
  createdBy   String?
  createdAt   DateTime @default(now())

  workOrder WorkOrder? @relation(fields: [workOrderId], references: [id])

  @@map("qc_reports")
}

// ----------------------------------------------------------------------------
// BIẾN ĐỘNG TỒN & TIMELINE SERIAL
// ----------------------------------------------------------------------------

model StockMovement {
  id              String       @id @default(cuid())
  type            MovementType
  serialId        String?
  lotId           String?
  quantity        Int          @default(1)
  fromWarehouseId String?
  toWarehouseId   String?
  documentType    String? // tham chiếu loại chứng từ
  documentNumber  String?
  note            String?
  createdBy       String?
  createdAt       DateTime     @default(now())

  serial        Serial?    @relation(fields: [serialId], references: [id])
  fromWarehouse Warehouse? @relation("MovementFromWarehouse", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse? @relation("MovementToWarehouse", fields: [toWarehouseId], references: [id])

  @@index([serialId])
  @@index([createdAt])
  @@map("stock_movements")
}

model SerialEvent {
  id         String        @id @default(cuid())
  serialId   String
  eventType  String // vd: STATUS_CHANGE, MOVE, ASSEMBLE, DISASSEMBLE, WARRANTY_INTAKE...
  fromStatus SerialStatus?
  toStatus   SerialStatus?
  detail     Json?
  createdBy  String?
  createdAt  DateTime      @default(now())

  serial Serial @relation(fields: [serialId], references: [id])

  @@index([serialId])
  @@index([createdAt])
  @@map("serial_events")
}

// ----------------------------------------------------------------------------
// KIỂM KÊ
// ----------------------------------------------------------------------------

model StockCount {
  id          String           @id @default(cuid())
  number      String           @unique
  warehouseId String?
  status      StockCountStatus @default(DRAFT)
  note        String?
  approvedBy  String?
  approvedAt  DateTime?
  createdAt   DateTime         @default(now())

  lines StockCountLine[]

  @@map("stock_counts")
}

/// Dòng kiểm kê từng serial: hệ thống kỳ vọng có / thực tế quét được.
model StockCountLine {
  id           String   @id @default(cuid())
  stockCountId String
  serialId     String?
  serialNumber String // lưu cả số serial để đối chiếu kể cả serial lạ
  /// true: hệ thống kỳ vọng serial này ở kho khi bắt đầu kiểm kê
  expected     Boolean  @default(false)
  /// true: thực tế đã quét thấy
  scanned      Boolean  @default(false)
  note         String?
  createdAt    DateTime @default(now())

  stockCount StockCount @relation(fields: [stockCountId], references: [id], onDelete: Cascade)

  @@index([stockCountId])
  @@map("stock_count_lines")
}

// ----------------------------------------------------------------------------
// BẢO HÀNH / SỬA CHỮA / HƯ HỎNG (M9)
// ----------------------------------------------------------------------------

model WarrantyIntake {
  id                String   @id @default(cuid())
  number            String   @unique
  serialId          String?
  customerId        String?
  originalInvoiceNo String?
  sealIntact        Boolean?
  conditionNote     String?
  photos            String?
  route             String? // TO_VENDOR(X4) / TO_REPAIR(K-SC) / TO_DAMAGED(K-HH)
  status            String   @default("OPEN") // OPEN / ROUTED / CLOSED
  createdAt         DateTime @default(now())

  @@map("warranty_intakes")
}

model VendorRma {
  id                  String    @id @default(cuid())
  number              String    @unique
  serialId            String?
  vendorId            String?
  sentDate            DateTime?
  shippingMethod      String?
  carrier             String?
  trackingNumber      String?
  slaDays             Int?
  status              String    @default("SENT") // SENT / RETURNED
  result              String? // REPAIRED / REPLACED
  replacementSerialId String?
  returnedAt          DateTime?
  createdAt           DateTime  @default(now())

  @@map("vendor_rma")
}

model DamagedItem {
  id         String           @id @default(cuid())
  serialId   String?
  cause      String?
  resolution DamageResolution @default(PENDING)
  /// Hạn chốt hướng xử lý — mặc định 15 ngày (SLA K-HH)
  dueDate    DateTime?
  resolvedAt DateTime?
  createdAt  DateTime         @default(now())

  @@map("damaged_items")
}

model RmaTicket {
  id            String   @id @default(cuid())
  number        String   @unique
  serialId      String?
  // claim bảo hành ngược NCC
  isVendorClaim Boolean  @default(false)
  vendorId      String?
  claimValue    Decimal? @db.Decimal(18, 2)
  status        String   @default("OPEN")
  createdAt     DateTime @default(now())

  @@map("rma_tickets")
}

// ----------------------------------------------------------------------------
// CHUYỂN KHO / GIAO HÀNG / THUÊ / RÃ MÁY
// ----------------------------------------------------------------------------

model TransferOrder {
  id              String         @id @default(cuid())
  number          String         @unique
  fromWarehouseId String
  toWarehouseId   String
  status          DocumentStatus @default(DRAFT)
  reason          String?
  createdAt       DateTime       @default(now())

  @@map("transfer_orders")
}

model DeliveryReport {
  id              String    @id @default(cuid())
  number          String    @unique
  outboundOrderId String?
  deliveredAt     DateTime?
  method          String? // hình thức giao
  carrier         String? // phương tiện/đơn vị vận chuyển
  trackingNumber  String? // mã vận đơn
  signatureUrl    String? // ký điện tử
  packingVideoUrl String? // video đóng gói (hàng giá trị cao)
  serialNumbers   String? // chốt danh sách serial đã giao (JSON/CSV)
  createdAt       DateTime  @default(now())

  outboundOrder OutboundOrder? @relation(fields: [outboundOrderId], references: [id])

  @@map("delivery_reports")
}

model RentalContract {
  id         String    @id @default(cuid())
  number     String    @unique
  customerId String?
  serialId   String?
  startDate  DateTime?
  dueDate    DateTime? // hạn thu hồi
  returnedAt DateTime?
  createdAt  DateTime  @default(now())

  @@map("rental_contracts")
}

model DisassemblyOrder {
  id             String         @id @default(cuid())
  number         String         @unique
  parentSerialId String
  reason         String?
  status         DocumentStatus @default(DRAFT)
  /// Rã máy BẮT BUỘC duyệt cấp quản lý/BGĐ (M10)
  approvedBy     String?
  approvedAt     DateTime?
  executedAt     DateTime?
  createdAt      DateTime       @default(now())

  @@map("disassembly_orders")
}

// ----------------------------------------------------------------------------
// AUDIT LOG — append-only (immutable)
// ----------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String // CREATE / UPDATE / APPROVE / STATUS_CHANGE / LOGIN...
  entityType String
  entityId   String?
  changes    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================================
// MODULE SPA / THẨM MỸ — Quản lý Khách hàng · Booking · Dịch vụ · Phác đồ · Chi phí
// (theo bản mô tả "Hệ thống quản lý Khách hàng – Booking – Dịch vụ – Phác đồ – Chi phí")
//
// Nguyên tắc bất biến được mã hóa:
//   * Dữ liệu nghiệp vụ quan trọng KHÔNG hard-delete — dùng cờ isActive / status
//     (soft delete) và giữ nguyên bản ghi lịch sử.
//   * CrmActivity, Payment, TreatmentSession KHÔNG ghi đè — mỗi lần là một record
//     độc lập tạo thành timeline.
//   * TreatmentPlan có `version`; Booking đã hoàn thành giữ nguyên `price` tại thời
//     điểm chốt (không đổi khi bảng giá thay đổi).
//   * Tác nhân (nhân viên) lưu bằng tên (String) để đồng nhất với phần kho hiện có.
// ============================================================================

/// Giới tính khách hàng
enum Gender {
  MALE
  FEMALE
  OTHER
}

/// Vòng đời booking (mục 6)
enum BookingStatus {
  NEW // Mới
  PENDING // Chờ xác nhận
  CONFIRMED // Đã xác nhận
  ARRIVED // Khách đã đến
  IN_PROGRESS // Đang thực hiện
  COMPLETED // Hoàn thành
  CANCELLED // Hủy
  NO_SHOW // Khách không đến
  RESCHEDULED // Đổi lịch
}

/// Loại tương tác CSKH (mục 5) — có thể mở rộng
enum CrmActivityType {
  CALL
  SMS
  ZALO
  WHATSAPP
  EMAIL
  CONSULT // Tư vấn trực tiếp
  FEEDBACK // Khách phản hồi
  COMPLAINT // Khiếu nại
  INTERNAL_NOTE // Ghi chú nội bộ
  FOLLOW_UP // Follow-up
  REMINDER // Nhắc lịch
  AFTERCARE // Chăm sóc sau dịch vụ
  OTHER
}

/// Trạng thái phác đồ khách hàng
enum PlanStatus {
  DRAFT // Bản nháp/thiết kế
  PENDING_APPROVAL // Chờ duyệt
  APPROVED // Đã duyệt (chưa bắt đầu)
  ACTIVE // Đang thực hiện
  PAUSED // Tạm dừng
  COMPLETED // Hoàn thành
  CANCELLED // Hủy/Dừng giữa chừng
}

/// Trạng thái một giai đoạn của phác đồ
enum StageStatus {
  PENDING // Chưa bắt đầu
  IN_PROGRESS // Đang thực hiện
  COMPLETED // Hoàn thành
  CANCELLED // Hủy
}

/// Đơn vị tần suất buổi trong giai đoạn (mỗi X ngày/tuần/tháng)
enum FrequencyUnit {
  DAY // ngày
  WEEK // tuần
  MONTH // tháng
}

/// Trạng thái một buổi thực hiện
enum SessionStatus {
  PLANNED // Đã lên kế hoạch (buổi dự kiến)
  IN_PROGRESS // Đang thực hiện
  COMPLETED // Hoàn thành
  SKIPPED // Bỏ qua (không thực hiện buổi này)
  CANCELLED // Hủy
}

/// Hình thức thanh toán
enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  EWALLET
  OTHER
}

/// Ưu tiên công việc
enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

/// Trạng thái công việc/follow-up
enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

// ----------------------------------------------------------------------------
// KHÁCH HÀNG (mục 4) — hồ sơ trung tâm, mọi dữ liệu liên kết về đây
// ----------------------------------------------------------------------------
model Customer {
  id           String    @id @default(cuid())
  code         String    @unique // Mã khách hàng KH-xxxx
  fullName     String
  dob          DateTime?
  gender       Gender?
  phone        String?
  email        String?
  address      String?
  source       String? // Nguồn khách hàng (marketing/campaign/giới thiệu...)
  campaign     String? // Campaign gốc (nhãn text tự do)
  campaignId   String? // Attribution first-touch tới MarketingCampaign (mục 10)
  group        String? // Nhóm khách hàng (Thường/VIP...)
  tags         String[]  @default([])
  assignedTo   String? // Nhân viên phụ trách (tên)
  goals        String? // Mong muốn/mục tiêu tổng quát của khách
  note         String?
  customFields Json? // Custom Fields do doanh nghiệp tự thêm
  legacyId     String? // ID gốc từ hệ thống cũ (MySpa...) để đối chiếu khi import
  legacySource String? // Nguồn dữ liệu cũ (vd "MySpa")
  isActive     Boolean   @default(true) // soft delete
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  activities        CrmActivity[]
  bookings          Booking[]
  assessments       Assessment[]
  plans             TreatmentPlan[]
  sessions          TreatmentSession[]
  payments          Payment[]
  tasks             Task[]
  recommendations   ProductRecommendation[]
  formInstances     FormInstance[]
  proposals         TreatmentProposal[]
  careInstances     CareInstructionInstance[]
  mediaAssets       MediaAsset[]
  customerMaterials CustomerMaterial[]
  portalAccount     CustomerPortalAccount?
  invoices          Invoice[]
  deposits          Deposit[]
  marketingCampaign MarketingCampaign?        @relation(fields: [campaignId], references: [id])

  @@index([phone])
  @@index([campaignId])
  @@index([legacyId])
  @@map("customers")
}

// ----------------------------------------------------------------------------
// NHẬT KÝ CSKH — CRM TIMELINE (mục 5) — append-only, không ghi đè
// ----------------------------------------------------------------------------
model CrmActivity {
  id            String          @id @default(cuid())
  customerId    String
  type          CrmActivityType
  content       String
  result        String?
  occurredAt    DateTime        @default(now())
  performedBy   String? // Người thực hiện (tên)
  attachments   String[]        @default([]) // file/hình đính kèm (URL)
  nextAction    String? // Công việc tiếp theo
  followUpDate  DateTime? // Ngày cần follow-up tiếp theo
  followUpOwner String? // Người chịu trách nhiệm follow-up
  createdAt     DateTime        @default(now())

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId, occurredAt])
  @@map("crm_activities")
}

// ----------------------------------------------------------------------------
// DỊCH VỤ (mục 7) + nhóm dịch vụ
// ----------------------------------------------------------------------------
model ServiceCategory {
  id          String    @id @default(cuid())
  code        String    @unique
  name        String
  description String?
  isActive    Boolean   @default(true)
  services    Service[]

  @@map("service_categories")
}

enum ServiceStatus {
  ACTIVE // Hoạt động
  PAUSED // Tạm ngưng
  ARCHIVED // Lưu trữ
}

model Service {
  id                   String        @id @default(cuid())
  code                 String        @unique // Mã dịch vụ
  name                 String
  categoryId           String?
  description          String?
  status               ServiceStatus @default(ACTIVE)
  durationMinutes      Int? // Thời lượng thực hiện (mặc định khi tạo Lịch hẹn)
  machineMinutes       Int? // Thời gian chiếm dụng máy (nếu khác thời lượng)
  roomMinutes          Int? // Thời gian chiếm dụng phòng/giường (nếu cần)
  standardPrice        Decimal       @default(0) @db.Decimal(18, 2) // Giá chuẩn
  expectedCost         Decimal?      @db.Decimal(18, 2) // Giá vốn dự kiến (nhạy cảm)
  process              String? // Quy trình thực hiện
  // --- Chuyên môn (gợi ý — không ép buộc; soft ref sang thư viện) ---
  technologyIds        String[]      @default([]) // công nghệ liên quan
  protocolIds          String[]      @default([]) // protocol liên quan
  defaultTechnologyId  String?
  defaultProtocolId    String?
  staffRequirements    Json? // [{role, quantity, required}] — yêu cầu nhân sự (không gán tên)
  resourceRequirements Json? // {room:{required,default}, bed:{...}, machine:{...}}
  isActive             Boolean       @default(true) // = (status == ACTIVE), giữ tương thích lọc cũ
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @default(now()) @updatedAt

  category          ServiceCategory?          @relation(fields: [categoryId], references: [id])
  bookings          Booking[]
  sessions          TreatmentSession[]
  priceFloor        ServicePriceFloor?
  floorVersions     ServicePriceFloorVersion[]
  materialStandards ServiceMaterialStandard[]

  @@map("services")
}

// Vật tư định mức của một dịch vụ (dùng làm "vật tư dự kiến" khi ghi buổi).
model ServiceMaterialStandard {
  id              String  @id @default(cuid())
  serviceId       String
  name            String
  quantity        Decimal @default(1) @db.Decimal(14, 3)
  unit            String
  note            String?
  required        Boolean @default(false)
  spaProductId    String? // liên kết mềm SpaProduct
  usageMaterialId String? // liên kết mềm UsageMaterial (kho vật tư sử dụng)
  orderIndex      Int     @default(0)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
  @@map("service_material_standards")
}

// ----------------------------------------------------------------------------
// BOOKING (mục 6) — module trung tâm
// ----------------------------------------------------------------------------
model Booking {
  id                String        @id @default(cuid())
  code              String        @unique // Mã booking
  customerId        String
  serviceId         String?
  scheduledAt       DateTime // Ngày + giờ
  durationMinutes   Int?
  branch            String?
  room              String? // Phòng
  bed               String? // Giường
  machine           String? // Máy/thiết bị
  technician        String? // Kỹ thuật viên (tên)
  master            String? // Master/chuyên gia phụ trách (tên)
  assistants        String[]      @default([]) // Nhân sự hỗ trợ (tên)
  performer         String? // Người thực hiện (tên) — giữ tương thích dữ liệu cũ
  status            BookingStatus @default(NEW)
  price             Decimal?      @db.Decimal(18, 2) // Giá tại thời điểm booking (bất biến sau hoàn thành)
  discount          Decimal?      @db.Decimal(18, 2)
  deposit           Decimal?      @db.Decimal(18, 2)
  campaign          String? // Nhãn nguồn campaign (text tự do)
  campaignId        String? // Attribution tới MarketingCampaign (mục 10)
  // --- Liên kết phác đồ (soft ref — không rebuild phác đồ) ---
  planId            String? // Phác đồ liên quan
  stageId           String? // Giai đoạn trong phác đồ
  sessionNumber     Int? // Buổi số mấy trong phác đồ
  // --- Vòng đời lịch hẹn (đổi/hủy/không đến/override) ---
  createdBy         String? // Người tạo lịch
  confirmedAt       DateTime? // thời điểm xác nhận
  checkedInAt       DateTime? // thời điểm khách đến (check-in)
  startedAt         DateTime? // thời điểm bắt đầu thực hiện
  completedAt       DateTime? // thời điểm hoàn thành lịch
  cancelReason      String?
  cancelledBy       String?
  cancelledAt       DateTime?
  noShowReason      String?
  noShowBy          String?
  noShowAt          DateTime?
  rescheduleHistory Json? // [{from,to,oldResources,newResources,by,at,reason}]
  overrideLog       Json? // [{by,at,reason,conflicts}] — đặt đè cảnh báo trùng lịch
  note              String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  customer          Customer           @relation(fields: [customerId], references: [id])
  service           Service?           @relation(fields: [serviceId], references: [id])
  session           TreatmentSession? // buổi thực hiện gắn với booking (1-1)
  payments          Payment[]
  deposits          Deposit[]
  tasks             Task[]
  marketingCampaign MarketingCampaign? @relation(fields: [campaignId], references: [id])

  @@index([scheduledAt])
  @@index([customerId])
  @@map("bookings")
}

// ----------------------------------------------------------------------------
// ĐÁNH GIÁ TÌNH TRẠNG (mục 10) — có thể đánh giá lại nhiều lần
// ----------------------------------------------------------------------------
model Assessment {
  id          String   @id @default(cuid())
  customerId  String
  name        String // Tên tình trạng
  area        String? // Vùng cần thực hiện
  severity    String? // Mức độ
  description String?
  indicators  Json? // Chỉ số + custom fields
  images      String[] @default([])
  note        String? // Nhận xét chuyên viên
  assessedBy  String? // Người đánh giá
  assessedAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId, assessedAt])
  @@map("assessments")
}

// ----------------------------------------------------------------------------
// PHÁC ĐỒ KHÁCH HÀNG (mục 11–16) — Treatment Plan + giai đoạn + buổi
// ----------------------------------------------------------------------------
model TreatmentPlan {
  id               String     @id @default(cuid())
  code             String     @unique
  customerId       String
  name             String
  version          Int        @default(1) // phác đồ có version
  status           PlanStatus @default(DRAFT)
  goals            String? // Mục tiêu / mong muốn
  diagnosis        String? // Tình trạng/vấn đề chính
  totalPrice       Decimal?   @db.Decimal(18, 2)
  discount         Decimal?   @db.Decimal(18, 2)
  changeLog        Json? // Lịch sử thay đổi version (ai/khi/nội dung/lý do) — giữ tương thích
  // --- Kế hoạch thời gian (mục 3) ---
  plannedStartDate DateTime? // Ngày bắt đầu dự kiến
  plannedEndDate   DateTime? // Ngày kết thúc dự kiến
  // --- Người phụ trách (mục 3) ---
  designer         String? // Người thiết kế phác đồ
  approver         String? // Người duyệt (nếu có)
  approvedAt       DateTime? // Thời điểm duyệt
  createdBy        String?
  note             String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  customer        Customer                @relation(fields: [customerId], references: [id])
  stages          TreatmentStage[]
  sessions        TreatmentSession[]
  versions        TreatmentPlanVersion[]
  payments        Payment[]
  tasks           Task[]
  recommendations ProductRecommendation[]
  formInstances   FormInstance[]
  proposals       TreatmentProposal[]
  invoices        Invoice[]

  @@index([customerId])
  @@map("treatment_plans")
}

/// Lịch sử phiên bản phác đồ (mục 16–18) — mỗi lần "Tạo version mới" ghi 1 dòng, không ghi đè
model TreatmentPlanVersion {
  id          String   @id @default(cuid())
  planId      String
  fromVersion Int? // version trước (null nếu là bản gốc)
  toVersion   Int // version mới
  reason      String // Lý do thay đổi (bắt buộc)
  summary     String? // Tóm tắt thay đổi (vd: "Thêm 1 buổi phục hồi; đổi Protocol buổi 4")
  note        String?
  createdBy   String?
  createdAt   DateTime @default(now())

  plan TreatmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, toVersion])
  @@map("treatment_plan_versions")
}

model TreatmentStage {
  id               String         @id @default(cuid())
  planId           String
  name             String // Giai đoạn (Chuẩn bị/Can thiệp/Phục hồi/Duy trì...)
  orderIndex       Int            @default(0)
  description      String? // Mục tiêu giai đoạn
  // --- Kế hoạch giai đoạn (mục 5–6) ---
  status           StageStatus    @default(PENDING)
  plannedStartDate DateTime? // Ngày bắt đầu dự kiến
  plannedEndDate   DateTime? // Ngày kết thúc dự kiến
  plannedSessions  Int? // Số buổi dự kiến
  frequencyValue   Int? // Tần suất: mỗi X ...
  frequencyUnit    FrequencyUnit? // ... ngày/tuần/tháng
  note             String?

  plan     TreatmentPlan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  sessions TreatmentSession[]

  @@index([planId, orderIndex])
  @@map("treatment_stages")
}

/// Mỗi buổi thực hiện là một record độc lập (mục 16) — không ghi đè buổi trước
model TreatmentSession {
  id                   String        @id @default(cuid())
  planId               String
  stageId              String?
  customerId           String
  bookingId            String?       @unique
  serviceId            String?
  sessionNumber        Int // Buổi số mấy
  name                 String?
  status               SessionStatus @default(PLANNED)
  scheduledAt          DateTime?
  performedAt          DateTime?
  performer            String?
  objective            String? // Mục tiêu buổi
  plannedParams        Json? // Thông số dự kiến
  actualParams         Json? // Thông số thực tế
  plannedMaterials     Json? // Vật tư dự kiến
  actualMaterials      Json? // Vật tư thực tế (liên kết chi phí)
  conditionBefore      String?
  conditionAfter       String?
  beforeImages         String[]      @default([]) // Báo cáo trước (mục 17)
  afterImages          String[]      @default([]) // Báo cáo sau
  customerFeedback     String?
  preCare              String? // Dặn dò trước
  postCare             String? // Dặn dò sau
  plannedCost          Decimal?      @db.Decimal(18, 2)
  actualCost           Decimal?      @db.Decimal(18, 2) // Chi phí thực tế (mục 20)
  price                Decimal?      @db.Decimal(18, 2)
  note                 String?
  checkedBy            String? // Người kiểm tra/phê duyệt
  // --- KẾ HOẠCH riêng cho buổi (mục 8, 14) — KHÔNG bị ghi đè bởi thực tế ---
  plannedServiceId     String? // Dịch vụ dự kiến
  plannedTechnologyId  String? // Công nghệ dự kiến
  plannedProtocolId    String? // Protocol dự kiến
  plannedStaff         Json? // Vai trò nhân sự dự kiến [{role, quantity}]
  plannedDate          DateTime? // Ngày dự kiến (kế hoạch — tách khỏi scheduledAt của lịch hẹn)
  intervalDays         Int? // Khoảng cách với buổi trước (ngày)
  versionAtExecution   Int? // Ghim version phác đồ tại thời điểm thực hiện (mục 13, 19)
  // --- Treatment Plan Designer: buổi có thể phối công nghệ + brand protocol (THỰC TẾ khi ghi nhận) ---
  technologyId         String?
  brandProtocolId      String?
  orderIndex           Int           @default(0) // thứ tự buổi (kéo–thả sắp xếp)
  steps                Json? // Các bước thực hiện của buổi (từ protocol hoặc tùy chỉnh)
  professionalProducts Json? // Sản phẩm chuyên nghiệp dùng trong buổi (khác vật tư)
  materialCost         Decimal?      @db.Decimal(18, 2) // chi phí vật tư tiêu hao (tự tính, mục 8)
  // --- SESSION = LẦN THỰC HIỆN (mục 5) ---
  code                 String?       @unique // Mã Session (SS-xxxxxx)
  // B — Trước khi thực hiện
  prevReaction         String? // Phản ứng sau buổi trước
  todayWish            String? // Khách phản hồi/mong muốn hôm nay
  contraindications    String? // Chống chỉ định (cảnh báo nổi bật)
  warnings             String? // Cảnh báo chuyên môn/nguy cơ (cảnh báo nổi bật)
  currentMeds          String? // Thuốc/sản phẩm đang dùng
  // C — Thực hiện thực tế
  actualStartAt        DateTime? // Thời gian bắt đầu thực tế
  actualEndAt          DateTime? // Thời gian kết thúc thực tế
  treatmentArea        String? // Vùng thực hiện
  // F — Sau khi thực hiện
  incident             String? // Sự cố/bất thường
  handledAction        String? // Xử lý đã thực hiện
  nextSuggestion       String? // Đề xuất buổi tiếp theo
  followUpDate         DateTime? // Ngày follow-up đề xuất
  // Sửa sau hoàn thành — audit (mục 29): [{by, at, reason, changes:[{field, before, after}]}]
  editLog              Json?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  plan           TreatmentPlan             @relation(fields: [planId], references: [id], onDelete: Cascade)
  stage          TreatmentStage?           @relation(fields: [stageId], references: [id])
  customer       Customer                  @relation(fields: [customerId], references: [id])
  booking        Booking?                  @relation(fields: [bookingId], references: [id])
  service        Service?                  @relation(fields: [serviceId], references: [id])
  technology     Technology?               @relation(fields: [technologyId], references: [id])
  brandProtocol  BrandProtocol?            @relation(fields: [brandProtocolId], references: [id])
  tasks          Task[]
  formInstances  FormInstance[]
  careInstances  CareInstructionInstance[]
  materials      SessionMaterial[]
  materialUsages MaterialUsage[]
  mediaAssets    MediaAsset[]
  staff          SessionStaff[]
  review         SessionReview?

  @@index([planId, sessionNumber])
  @@index([customerId])
  @@map("treatment_sessions")
}

// ----------------------------------------------------------------------------
// THANH TOÁN & CÔNG NỢ (mục 21) — nhiều lần thanh toán, append-only
// ----------------------------------------------------------------------------
model Payment {
  id         String        @id @default(cuid())
  code       String?       @unique // PT-xxxxxx mã phiếu thu
  customerId String
  planId     String?
  bookingId  String?
  invoiceId  String? // Thanh toán gắn với hóa đơn (mục 18) — 1 hóa đơn nhiều lần trả
  amount     Decimal       @db.Decimal(18, 2)
  method     PaymentMethod @default(CASH)
  txnRef     String? // mã tham chiếu giao dịch (số CK/mã POS/ví...)
  paidAt     DateTime      @default(now())
  receivedBy String?
  note       String?
  // --- Hủy phiếu thu (không hard-delete, giữ vết) ---
  voidedAt   DateTime?
  voidReason String?
  voidedBy   String?
  createdAt  DateTime      @default(now())

  customer Customer       @relation(fields: [customerId], references: [id])
  plan     TreatmentPlan? @relation(fields: [planId], references: [id])
  booking  Booking?       @relation(fields: [bookingId], references: [id])
  invoice  Invoice?       @relation(fields: [invoiceId], references: [id])

  @@index([customerId, paidAt])
  @@index([invoiceId])
  @@map("payments")
}

// ----------------------------------------------------------------------------
// TASK & FOLLOW-UP (mục 22)
// ----------------------------------------------------------------------------
model Task {
  id                 String           @id @default(cuid())
  title              String
  description        String?
  customerId         String?
  bookingId          String?
  planId             String?
  sessionId          String?
  assignee           String? // Người phụ trách (tên)
  dueDate            DateTime?
  priority           TaskPriority     @default(NORMAL)
  status             TaskStatus       @default(OPEN)
  channel            DeliveryChannel? // Kênh liên hệ (follow-up CSKH: gọi/Zalo/SMS...)
  followUpTemplateId String? // nguồn: quy trình CSKH đã áp (mục 31)
  checklist          Json? // checklist việc cần làm của bước follow-up
  createdBy          String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  customer Customer?         @relation(fields: [customerId], references: [id])
  booking  Booking?          @relation(fields: [bookingId], references: [id])
  plan     TreatmentPlan?    @relation(fields: [planId], references: [id])
  session  TreatmentSession? @relation(fields: [sessionId], references: [id])

  @@index([status, dueDate])
  @@index([customerId])
  @@map("tasks")
}

// ============================================================================
// MODULE SPA — THƯ VIỆN: Brand · Technology · Brand/Internal Protocol · Product
//   + Protocol/Form Builder (biểu mẫu động) + Product Recommendation
// (theo bản "Bổ sung yêu cầu — Phác đồ / Công nghệ / Brand Protocol / Sản phẩm")
//
// Nguyên tắc: Admin cấu hình được (không hard-code brand); protocol/form có
// version + trạng thái phê duyệt; áp template cho khách tạo INSTANCE riêng
// không đổi bản gốc; soft delete; giữ lịch sử.
// ============================================================================

/// Trạng thái phê duyệt cho Protocol Library & Form Template (mục 19)
enum LibraryStatus {
  DRAFT
  REVIEW
  APPROVED
  ACTIVE
  ARCHIVED
}

/// Protocol thuộc hãng hay nội bộ doanh nghiệp
enum ProtocolKind {
  BRAND // Protocol chuẩn của hãng (DMK, Dermalogica, Klapp...)
  INTERNAL // Protocol nội bộ do doanh nghiệp tự xây (có thể compose từ nhiều nguồn)
}

/// Loại sản phẩm theo logic chi phí/doanh thu (mục 15 phần bổ sung)
enum ProductType {
  PROFESSIONAL // Dùng trong quá trình thực hiện dịch vụ (ảnh hưởng chi phí session)
  HOME_CARE // Bán/đề xuất khách dùng tại nhà (doanh thu bán lẻ)
  BOTH
}

/// Mức ưu tiên đề xuất sản phẩm (mục 12 phần bổ sung)
enum RecommendationPriority {
  ESSENTIAL // Nên có
  RECOMMENDED // Khuyến nghị
  OPTIONAL // Tùy chọn
}

// ----------------------------------------------------------------------------
// BRAND (mục 2 phần bổ sung) — không hard-code, Admin tự thêm
// ----------------------------------------------------------------------------
model Brand {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  logoUrl     String?
  description String?
  documents   String[] @default([]) // tài liệu đào tạo / PDF / hướng dẫn kỹ thuật (URL)
  note        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  technologies Technology[]
  protocols    BrandProtocol[]
  products     SpaProduct[]

  @@map("brands")
}

// ----------------------------------------------------------------------------
// TECHNOLOGY (mục 1 phần bổ sung)
// ----------------------------------------------------------------------------
model Technology {
  id                String   @id @default(cuid())
  code              String   @unique
  name              String
  group             String? // Nhóm công nghệ
  brandId           String?
  deviceModel       String? // Model thiết bị
  description       String?
  indications       String? // Chỉ định sử dụng
  applicableCond    String? // Điều kiện áp dụng
  contraindications String? // Chống chỉ định
  area              String? // Vùng thực hiện
  durationMinutes   Int?
  parameters        Json? // Thông số có thể thiết lập
  preCare           String? // Hướng dẫn trước
  postCare          String? // Hướng dẫn sau
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  brand     Brand?                    @relation(fields: [brandId], references: [id])
  protocols BrandProtocolTechnology[]
  sessions  TreatmentSession[]

  @@map("technologies")
}

// ----------------------------------------------------------------------------
// BRAND / INTERNAL PROTOCOL LIBRARY (mục 3, 18, 19 phần bổ sung)
// Khác với TreatmentPlan (phác đồ riêng của khách).
// ----------------------------------------------------------------------------
model BrandProtocol {
  id                String        @id @default(cuid())
  code              String        @unique
  name              String
  kind              ProtocolKind  @default(BRAND)
  brandId           String?
  version           Int           @default(1)
  status            LibraryStatus @default(DRAFT)
  purpose           String? // Mục tiêu
  suitableFor       String? // Đối tượng/tình trạng phù hợp
  contraindications String? // Chống chỉ định
  steps             Json? // Các bước + thời gian từng bước
  durationMinutes   Int?
  parameters        Json? // Thông số
  preCare           String? // Hướng dẫn trước
  postCare          String? // Hướng dẫn sau
  recommendedFreq   String? // Tần suất khuyến nghị
  recommendedCount  Int? // Số lần khuyến nghị
  attachments       String[]      @default([]) // hình ảnh/video/tài liệu (URL)
  note              String? // Ghi chú chuyên môn
  sourceRef         String? // Nguồn tham khảo (khi INTERNAL compose từ nhiều hãng)
  changeLog         Json? // Lịch sử version
  createdBy         String?
  isActive          Boolean       @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  brand        Brand?                    @relation(fields: [brandId], references: [id])
  technologies BrandProtocolTechnology[]
  products     BrandProtocolProduct[]
  sessions     TreatmentSession[]

  @@index([brandId])
  @@index([status])
  @@map("brand_protocols")
}

/// Join: protocol ↔ công nghệ sử dụng
model BrandProtocolTechnology {
  brandProtocolId String
  technologyId    String
  brandProtocol   BrandProtocol @relation(fields: [brandProtocolId], references: [id], onDelete: Cascade)
  technology      Technology    @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@id([brandProtocolId, technologyId])
  @@map("brand_protocol_technologies")
}

/// Join: protocol ↔ sản phẩm sử dụng
model BrandProtocolProduct {
  brandProtocolId String
  spaProductId    String
  usage           String? // cách dùng trong protocol
  brandProtocol   BrandProtocol @relation(fields: [brandProtocolId], references: [id], onDelete: Cascade)
  product         SpaProduct    @relation(fields: [spaProductId], references: [id], onDelete: Cascade)

  @@id([brandProtocolId, spaProductId])
  @@map("brand_protocol_products")
}

// ----------------------------------------------------------------------------
// PRODUCT CATALOG (mục 11 phần bổ sung) — tách riêng với Product (kho THNG)
// ----------------------------------------------------------------------------
model SpaProduct {
  id                 String      @id @default(cuid())
  sku                String      @unique
  name               String
  brandId            String?
  category           String?
  imageUrl           String?
  description        String?
  benefits           String? // Công dụng
  suitableFor        String? // Tình trạng phù hợp
  usage              String? // Hướng dẫn sử dụng
  sellingPrice       Decimal?    @db.Decimal(18, 2)
  cost               Decimal?    @db.Decimal(18, 2) // Giá vốn (nhạy cảm)
  productType        ProductType @default(HOME_CARE)
  inventoryProductId String? // Liên kết mềm tới Product kho (module 8 — sẽ nối sau)
  isActive           Boolean     @default(true)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  brand            Brand?                  @relation(fields: [brandId], references: [id])
  protocols        BrandProtocolProduct[]
  recommendations  ProductRecommendation[]
  sessionMaterials SessionMaterial[]

  @@map("spa_products")
}

// ----------------------------------------------------------------------------
// PRODUCT RECOMMENDATION (mục 12 phần bổ sung)
// ----------------------------------------------------------------------------
model ProductRecommendation {
  id           String                 @id @default(cuid())
  customerId   String
  planId       String?
  spaProductId String
  reason       String? // Lý do đề xuất
  goal         String? // Mục tiêu sử dụng
  usage        String? // Hướng dẫn sử dụng
  duration     String? // Thời gian sử dụng
  quantity     Int                    @default(1)
  price        Decimal?               @db.Decimal(18, 2)
  priority     RecommendationPriority @default(RECOMMENDED)
  note         String?
  createdBy    String?
  createdAt    DateTime               @default(now())

  customer Customer       @relation(fields: [customerId], references: [id])
  plan     TreatmentPlan? @relation(fields: [planId], references: [id])
  product  SpaProduct     @relation(fields: [spaProductId], references: [id])

  @@index([customerId])
  @@map("product_recommendations")
}

// ----------------------------------------------------------------------------
// PROTOCOL / FORM BUILDER (mục 11–15 gốc) — biểu mẫu động kéo–thả
// `schema` (Json) lưu định nghĩa: tabs/sections/groups/fields + conditional logic.
// ----------------------------------------------------------------------------
model FormTemplate {
  id          String        @id @default(cuid())
  code        String        @unique
  name        String
  description String?
  category    String? // vd: "Phác đồ", "Đánh giá", "Tư vấn"
  version     Int           @default(1)
  status      LibraryStatus @default(DRAFT)
  schema      Json // FormSchema: { tabs, sections, groups, fields, logic }
  changeLog   Json?
  createdBy   String?
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  instances FormInstance[]

  @@index([status])
  @@map("form_templates")
}

/// Instance riêng khi áp template cho khách/phác đồ/buổi — KHÔNG đổi template gốc.
model FormInstance {
  id              String             @id @default(cuid())
  templateId      String
  templateVersion Int // version template tại thời điểm áp
  schemaSnapshot  Json // bản sao schema tại thời điểm áp (bất biến)
  data            Json? // giá trị các field khách/buổi
  customerId      String?
  planId          String?
  sessionId       String?
  name            String?
  status          FormInstanceStatus @default(DRAFT) // hoàn thành khi điền xong (mục 7)
  completedBy     String?
  completedAt     DateTime?
  createdBy       String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  template FormTemplate      @relation(fields: [templateId], references: [id])
  customer Customer?         @relation(fields: [customerId], references: [id])
  plan     TreatmentPlan?    @relation(fields: [planId], references: [id])
  session  TreatmentSession? @relation(fields: [sessionId], references: [id])

  @@index([customerId])
  @@index([templateId])
  @@index([sessionId])
  @@map("form_instances")
}

enum FormInstanceStatus {
  DRAFT
  COMPLETED
}

// ============================================================================
// MODULE 5 — TREATMENT PROPOSAL / PHƯƠNG ÁN NGÂN SÁCH
// Nhiều phương án (Essential/Recommended/Premium/Custom) cho 1 khách; khách chốt
// 1 phương án -> lưu SNAPSHOT bất biến (giá catalog đổi về sau không ảnh hưởng).
// Giá vốn/margin/ghi chú nội bộ chỉ role finance.read thấy (mask ở server).
// ============================================================================
enum ProposalStatus {
  DRAFT
  SENT // đã gửi khách
  VIEWING // khách đang xem
  ACCEPTED // khách đã chốt
  REJECTED
  EXPIRED
  CONVERTED // đã chuyển thành hóa đơn
  CANCELLED // hủy
}

enum ProposalOptionKind {
  ESSENTIAL
  RECOMMENDED
  PREMIUM
  CUSTOM
}

enum ProposalItemType {
  SERVICE
  TECHNOLOGY
  BRAND_PROTOCOL
  PRODUCT // home-care hoặc professional (phân biệt bằng isHomeCare)
  CUSTOM
}

model TreatmentProposal {
  id               String         @id @default(cuid())
  code             String         @unique
  customerId       String
  planId           String?
  title            String
  status           ProposalStatus @default(DRAFT)
  version          Int            @default(1)
  note             String? // ghi chú nội bộ (ẩn khỏi khách)
  createdBy        String?
  // --- Chốt phương án (snapshot bất biến) ---
  priceAdjustReason String? // lý do điều chỉnh giá khi chốt (khác giá phương án gốc / bán dưới sàn)
  acceptedOptionId String?
  acceptedAt       DateTime?
  acceptedBy       String?
  agreedPrice      Decimal?       @db.Decimal(18, 2)
  appliedDiscount  Decimal?       @db.Decimal(18, 2)
  acceptedSnapshot Json? // bản đông cứng option đã chọn (item + giá) tại thời điểm chốt
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  customer Customer                  @relation(fields: [customerId], references: [id])
  plan     TreatmentPlan?            @relation(fields: [planId], references: [id])
  options  TreatmentProposalOption[]
  invoices Invoice[]

  @@index([customerId])
  @@map("treatment_proposals")
}

model TreatmentProposalOption {
  id                    String             @id @default(cuid())
  proposalId            String
  kind                  ProposalOptionKind @default(RECOMMENDED)
  name                  String
  orderIndex            Int                @default(0)
  sessions              Int? // số buổi
  estimatedDurationDays Int? // thời gian dự kiến (ngày)
  discount              Decimal?           @db.Decimal(18, 2)
  totalPrice            Decimal?           @db.Decimal(18, 2) // tổng (tự tính, có thể lưu chốt)
  note                  String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  proposal TreatmentProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  items    ProposalItem[]

  @@index([proposalId])
  @@map("treatment_proposal_options")
}

model ProposalItem {
  id         String           @id @default(cuid())
  optionId   String
  itemType   ProposalItemType @default(SERVICE)
  refId      String? // id service/technology/brandProtocol/spaProduct (tham chiếu mềm)
  name       String // snapshot tên tại thời điểm lập
  quantity   Int              @default(1)
  sessions   Int?
  unitPrice  Decimal?         @db.Decimal(18, 2) // giá bán khách (snapshot)
  unitCost   Decimal?         @db.Decimal(18, 2) // giá vốn nội bộ (nhạy cảm, mask)
  isHomeCare Boolean          @default(false) // phân biệt SP tại nhà vs dùng trong buổi
  note       String?
  orderIndex Int              @default(0)

  option TreatmentProposalOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@index([optionId])
  @@map("proposal_items")
}

// ============================================================================
// MODULE 6 — PRE/POST-CARE INSTRUCTION LIBRARY
// Thư viện hướng dẫn tái sử dụng; khi gửi khách -> tạo INSTANCE (snapshot),
// nhân viên cá nhân hóa bản của khách mà KHÔNG đổi template gốc.
// ============================================================================
enum CareKind {
  PRE_CARE
  POST_CARE
  GENERAL
  FOLLOW_UP
}

/// Kênh gửi (chuẩn bị cho Customer Portal/Email/Zalo/WhatsApp/SMS về sau)
enum DeliveryChannel {
  IN_PERSON
  PORTAL
  EMAIL
  ZALO
  WHATSAPP
  SMS
}

model CareInstruction {
  id              String        @id @default(cuid())
  code            String        @unique
  title           String
  kind            CareKind      @default(PRE_CARE)
  category        String?
  content         String // nội dung template
  version         Int           @default(1)
  status          LibraryStatus @default(DRAFT)
  attachments     String[]      @default([])
  // liên kết mềm tới thực thể (lọc gợi ý theo dịch vụ/công nghệ/protocol/tình trạng/sản phẩm)
  serviceId       String?
  technologyId    String?
  brandProtocolId String?
  spaProductId    String?
  condition       String?
  changeLog       Json?
  createdBy       String?
  updatedBy       String?
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  instances CareInstructionInstance[]

  @@index([kind])
  @@index([status])
  @@map("care_instructions")
}

/// Bản đã gửi/áp cho khách/buổi — lưu ĐÚNG nội dung khách nhận (snapshot).
model CareInstructionInstance {
  id              String          @id @default(cuid())
  templateId      String?
  kind            CareKind        @default(PRE_CARE)
  title           String
  content         String // bản cá nhân hóa (đã snapshot từ template, có thể sửa)
  templateVersion Int? // version template tại thời điểm áp
  customerId      String
  sessionId       String?
  bookingId       String?
  deliveredVia    DeliveryChannel @default(IN_PERSON)
  deliveredAt     DateTime?
  acknowledgedAt  DateTime? // khách xác nhận đã đọc (qua Customer Portal)
  providedBy      String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  template CareInstruction?  @relation(fields: [templateId], references: [id])
  customer Customer          @relation(fields: [customerId], references: [id])
  session  TreatmentSession? @relation(fields: [sessionId], references: [id])

  @@index([customerId])
  @@map("care_instruction_instances")
}

// ============================================================================
// MODULE 8 — MATERIALS ↔ INVENTORY ↔ TREATMENT SESSION
// Luồng: kế hoạch vật tư → yêu cầu → giữ hàng → xuất → tiêu hao → hoàn/hao/hỏng.
// Tiêu hao thực tế đóng góp vào chi phí thật của buổi (materialCost).
// Tham chiếu kho (Product/Warehouse) dạng soft String để tránh siết chặt phần kho;
// SpaProduct (sản phẩm chuyên nghiệp) liên kết cứng để lấy giá vốn.
// ============================================================================
enum MaterialMovementType {
  REQUEST // yêu cầu vật tư
  RESERVE // giữ hàng
  ISSUE // xuất kho
  CONSUME // tiêu hao thực tế
  RETURN // hoàn trả về kho
  WASTE // hao hụt
  DAMAGE // hư hỏng
}

model SessionMaterial {
  id                 String   @id @default(cuid())
  sessionId          String
  name               String // snapshot tên vật tư/sản phẩm
  spaProductId       String? // sản phẩm chuyên nghiệp (có giá vốn)
  inventoryProductId String? // Product kho (soft ref)
  lotId              String? // Lô kho thực (khi có -> trừ tồn thật qua StockMovement)
  warehouseId        String? // kho (soft ref / suy ra từ lot)
  uom                String? // đơn vị
  isProfessional     Boolean  @default(false) // SP chuyên nghiệp dùng trong buổi (≠ home-care bán khách)
  plannedQty         Decimal  @default(0) @db.Decimal(14, 3)
  reservedQty        Decimal  @default(0) @db.Decimal(14, 3)
  issuedQty          Decimal  @default(0) @db.Decimal(14, 3)
  consumedQty        Decimal  @default(0) @db.Decimal(14, 3)
  returnedQty        Decimal  @default(0) @db.Decimal(14, 3)
  wasteQty           Decimal  @default(0) @db.Decimal(14, 3)
  unitCost           Decimal? @db.Decimal(18, 2) // giá vốn snapshot tại thời điểm lập
  note               String?
  createdBy          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  session   TreatmentSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  product   SpaProduct?        @relation(fields: [spaProductId], references: [id])
  lot       Lot?               @relation(fields: [lotId], references: [id])
  movements MaterialMovement[]

  @@index([sessionId])
  @@index([lotId])
  @@map("session_materials")
}

model MaterialMovement {
  id                String               @id @default(cuid())
  sessionMaterialId String
  type              MaterialMovementType
  quantity          Decimal              @db.Decimal(14, 3)
  unitCost          Decimal?             @db.Decimal(18, 2) // snapshot giá vốn
  warehouseId       String?
  lotId             String? // lô kho bị tác động (nếu có)
  stockMovementId   String? // liên kết tới StockMovement (ledger kho — source of truth)
  bookingId         String?
  customerId        String?
  staff             String?
  note              String?
  createdAt         DateTime             @default(now())

  sessionMaterial SessionMaterial @relation(fields: [sessionMaterialId], references: [id], onDelete: Cascade)

  @@index([sessionMaterialId])
  @@map("material_movements")
}

// ============================================================================
// MODULE 9 — VERSIONED PRICE MANAGEMENT
// Giá áp cho Dịch vụ/Sản phẩm/Công nghệ/Gói. KHÔNG ghi đè giá lịch sử: đổi giá =
// tạo bản ghi mới (append-only), bản cũ archive. Booking/Proposal/Session đã lưu
// SNAPSHOT giá tại thời điểm tạo -> đổi bảng giá không ảnh hưởng bản ghi lịch sử.
// Tham chiếu target dạng soft String để không siết chặt các module khác.
// ============================================================================
enum PriceTargetType {
  SERVICE
  PRODUCT
  TECHNOLOGY
  PACKAGE
}

enum PriceType {
  STANDARD // niêm yết
  BRANCH // theo chi nhánh
  MEMBER // thành viên
  VIP
  CAMPAIGN // khuyến mãi
  CUSTOM // đặc biệt
}

model PriceRule {
  id            String          @id @default(cuid())
  targetType    PriceTargetType
  targetId      String // id service/product/technology/package (soft ref)
  targetName    String? // snapshot tên để hiển thị lịch sử
  priceType     PriceType       @default(STANDARD)
  branch        String?
  price         Decimal         @db.Decimal(18, 2)
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  campaign      String?
  note          String?
  version       Int             @default(1)
  supersedesId  String? // trỏ tới bản giá bị thay thế (giữ lịch sử)
  isActive      Boolean         @default(true)
  createdBy     String?
  createdAt     DateTime        @default(now())

  @@index([targetType, targetId])
  @@index([isActive])
  @@map("price_rules")
}

// ============================================================================
// MODULE 10 — MARKETING / SOURCE / ROI
// Chiến dịch → Lead → Khách hàng → Booking → Doanh thu. Attribution first-touch
// (Customer.campaignId / Booking.campaignId) — thiết kế mở để mở rộng multi-touch.
// ============================================================================
enum LeadStatus {
  NEW
  CONTACTED
  BOOKED
  WON // đã chuyển thành khách
  LOST
}

model MarketingCampaign {
  id          String    @id @default(cuid())
  code        String    @unique
  name        String
  channel     String? // kênh marketing (tự do, không hard-code)
  startDate   DateTime?
  endDate     DateTime?
  budget      Decimal?  @db.Decimal(18, 2)
  cost        Decimal?  @db.Decimal(18, 2) // chi phí thực tế (nhạy cảm)
  targetGroup String?
  owner       String?
  status      String    @default("ACTIVE") // ACTIVE / ENDED
  note        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  leads     Lead[]
  customers Customer[]
  bookings  Booking[]

  @@map("marketing_campaigns")
}

model Lead {
  id                  String     @id @default(cuid())
  code                String     @unique
  name                String
  phone               String?
  email               String?
  source              String? // nguồn (facebook/zalo/giới thiệu...)
  channel             String?
  campaignId          String?
  status              LeadStatus @default(NEW)
  note                String?
  convertedCustomerId String? // khi WON -> id khách hàng đã tạo/gắn
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  campaign MarketingCampaign? @relation(fields: [campaignId], references: [id])

  @@index([status])
  @@index([campaignId])
  @@map("leads")
}

// ============================================================================
// P3 — LƯU TRỮ MEDIA RIÊNG TƯ (ảnh khách / before-after / tệp / chữ ký)
// Blob lưu qua StorageProvider (local FS ngoài public/, có thể đổi sang S3).
// KHÔNG dùng URL công khai — truy cập qua /api/media/[id] có kiểm quyền.
// Xóa = archive mềm (không mồ côi bản ghi tham chiếu).
// ============================================================================
enum MediaKind {
  IMAGE
  BEFORE_IMAGE
  AFTER_IMAGE
  VIDEO
  FILE
  SIGNATURE
}

model MediaAsset {
  id                 String    @id @default(cuid())
  storageKey         String    @unique // khóa/đường dẫn trong storage (không public)
  filename           String // tên gốc
  contentType        String
  size               Int // bytes
  kind               MediaKind @default(FILE)
  customerId         String? // phạm vi thuộc khách nào (dùng cho authz portal)
  sessionId          String?
  protocolId         String? // soft ref
  sharedWithCustomer Boolean   @default(false) // nhân viên chủ động chia sẻ cho khách xem
  uploadedBy         String?
  isArchived         Boolean   @default(false)
  createdAt          DateTime  @default(now())

  customer Customer?         @relation(fields: [customerId], references: [id])
  session  TreatmentSession? @relation(fields: [sessionId], references: [id])

  @@index([customerId])
  @@index([sessionId])
  @@map("media_assets")
}

// ============================================================================
// P5 — CUSTOMER PORTAL: tài khoản đăng nhập riêng của KHÁCH (tách khỏi User staff).
// Phiên portal mang customerId; MỌI truy vấn portal chỉ trong phạm vi khách đó.
// ============================================================================
model CustomerPortalAccount {
  id           String    @id @default(cuid())
  customerId   String    @unique
  email        String    @unique
  passwordHash String
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())

  customer Customer @relation(fields: [customerId], references: [id])

  @@map("customer_portal_accounts")
}

// ============================================================================
// SEC1 — Chống brute-force đăng nhập (DB-backed -> đúng trên multi-instance/serverless).
// Đếm thất bại theo "key" (ip / account) trong cửa sổ thời gian; khóa TẠM THỜI
// lũy tiến. KHÔNG bao giờ khóa vĩnh viễn; không lưu mật khẩu/bí mật.
// ============================================================================
model AuthThrottle {
  key         String    @id // vd: "staff:ip:1.2.3.4", "staff:acct:<email>", "portal:acct:<email>"
  failures    Int       @default(0)
  firstFailAt DateTime  @default(now())
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt

  @@index([lockedUntil])
  @@map("auth_throttles")
}

// ============================================================================
// MODULE VẬT TƯ SPA (đơn giản hóa — 2 khái niệm nghiệp vụ)
//   1) "Kho vật tư sử dụng"  = UsageMaterial + MaterialContainer (lọ/chai/lô dùng
//      chung nhiều khách, nhiều buổi; theo dõi tồn còn lại + cost snapshot).
//   2) "Vật tư khách hàng"   = CustomerMaterial (dành riêng 1 khách, không dùng
//      cho khách khác; dùng qua nhiều buổi).
//   Lịch sử tiêu hao chung: MaterialUsage (ghi từng lần dùng theo buổi/khách/NV).
//   Tách hoàn toàn khỏi Kho THNG (phần cứng) — không đụng SessionMaterial cũ.
// ============================================================================
enum MaterialSource {
  SHARED_STOCK // Kho vật tư sử dụng (container dùng chung)
  CUSTOMER_OWNED // Vật tư khách hàng
}

enum ContainerStatus {
  IN_USE // Đang sử dụng
  LOW // Sắp hết
  EMPTY // Hết
  DISPOSED // Đã hủy
}

enum CustomerMaterialStatus {
  ACTIVE // Đang sử dụng
  USED_UP // Đã dùng hết
  CANCELLED // Đã hủy
}

// Danh mục vật tư dùng chung ("Kho vật tư sử dụng")
model UsageMaterial {
  id                 String   @id @default(cuid())
  code               String   @unique
  name               String
  unit               String // đơn vị tiêu hao (ml, cái, lần...)
  category           String?
  serviceId          String? // liên kết mềm dịch vụ
  technologyId       String? // liên kết mềm công nghệ
  brandProtocolId    String? // liên kết mềm protocol
  expectedPerSession Decimal? @db.Decimal(14, 3) // định mức dự kiến / buổi
  lowThreshold       Decimal? @db.Decimal(14, 3) // ngưỡng cảnh báo sắp hết (theo container còn lại)
  isActive           Boolean  @default(true)
  createdBy          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  containers MaterialContainer[]

  @@index([isActive])
  @@map("usage_materials")
}

// Một lọ/chai/lô vật lý của UsageMaterial (dùng chung nhiều khách/buổi)
model MaterialContainer {
  id              String          @id @default(cuid())
  usageMaterialId String
  containerNo     String // mã lọ/lô (VD JETPEEL-2026-01)
  initialQty      Decimal         @db.Decimal(14, 3) // số lượng ban đầu
  remainingQty    Decimal         @db.Decimal(14, 3) // số lượng còn lại
  unit            String // đơn vị (snapshot từ material)
  costSnapshot    Decimal?        @db.Decimal(18, 2) // giá vốn cả lọ (để phân bổ chi phí)
  openedAt        DateTime? // ngày mở nắp
  expiryDate      DateTime? // hạn dùng / hạn sau mở nắp
  status          ContainerStatus @default(IN_USE)
  note            String?
  createdBy       String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  material UsageMaterial   @relation(fields: [usageMaterialId], references: [id], onDelete: Cascade)
  usages   MaterialUsage[]

  @@index([usageMaterialId])
  @@index([status])
  @@map("material_containers")
}

// Vật tư dành riêng cho 1 khách ("Vật tư khách hàng")
model CustomerMaterial {
  id              String                 @id @default(cuid())
  code            String                 @unique
  customerId      String
  name            String
  unit            String
  allocatedQty    Decimal                @db.Decimal(14, 3) // đã cấp
  usedQty         Decimal                @default(0) @db.Decimal(14, 3) // đã dùng
  unitCost        Decimal?               @db.Decimal(18, 2) // giá vốn/đơn vị (tùy chọn)
  planId          String? // liên kết mềm phác đồ
  brandProtocolId String? // liên kết mềm protocol
  status          CustomerMaterialStatus @default(ACTIVE)
  note            String?
  createdBy       String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  customer Customer        @relation(fields: [customerId], references: [id])
  usages   MaterialUsage[]

  @@index([customerId])
  @@map("customer_materials")
}

// Lịch sử tiêu hao vật tư (dùng cho cả 2 nguồn)
model MaterialUsage {
  id                 String         @id @default(cuid())
  source             MaterialSource
  containerId        String? // khi SHARED_STOCK
  customerMaterialId String? // khi CUSTOMER_OWNED
  sessionId          String?
  customerId         String?
  performedBy        String?
  quantity           Decimal        @db.Decimal(14, 3)
  remainingBefore    Decimal?       @db.Decimal(14, 3) // tồn trước khi dùng (snapshot)
  remainingAfter     Decimal?       @db.Decimal(14, 3) // tồn sau khi dùng (snapshot)
  unitCost           Decimal?       @db.Decimal(18, 2) // snapshot giá vốn/đơn vị
  costAllocated      Decimal?       @db.Decimal(18, 2) // chi phí phân bổ = quantity * unitCost
  serviceId          String? // snapshot (báo cáo theo dịch vụ)
  technologyId       String? // snapshot (báo cáo theo công nghệ)
  brandProtocolId    String? // snapshot (báo cáo theo protocol)
  note               String?
  occurredAt         DateTime       @default(now())
  createdAt          DateTime       @default(now())

  container        MaterialContainer? @relation(fields: [containerId], references: [id])
  customerMaterial CustomerMaterial?  @relation(fields: [customerMaterialId], references: [id])
  session          TreatmentSession?  @relation(fields: [sessionId], references: [id])

  @@index([sessionId])
  @@index([customerId])
  @@index([containerId])
  @@index([customerMaterialId])
  @@index([occurredAt])
  @@map("material_usages")
}

// =============================================================================
// HÓA ĐƠN & THANH TOÁN (mục 14–18) — Báo giá → Khách chốt → HÓA ĐƠN → Thanh toán
// → Công nợ. Công nợ tính từ HÓA ĐƠN (không phải báo giá). 1 hóa đơn = nhiều lần trả.
// =============================================================================

enum InvoiceStatus {
  UNPAID // chưa thanh toán
  PARTIAL // đã trả một phần
  PAID // đã thanh toán đủ
  CANCELLED // đã hủy (không tính công nợ)
}

model Invoice {
  id               String        @id @default(cuid())
  code             String        @unique // HĐ-xxxxxx
  customerId       String
  proposalId       String? // báo giá nguồn (khi tạo từ báo giá đã chốt)
  proposalOptionId String? // phương án đã chốt (tham chiếu mềm) — truy vết
  planId           String?
  status           InvoiceStatus @default(UNPAID)
  issuedAt         DateTime      @default(now())
  dueDate          DateTime?
  subtotal         Decimal       @default(0) @db.Decimal(18, 2) // tổng hạng mục trước chiết khấu
  discount         Decimal       @default(0) @db.Decimal(18, 2)
  total            Decimal       @default(0) @db.Decimal(18, 2) // phải thu = subtotal - discount
  note             String?
  createdBy        String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  customer Customer           @relation(fields: [customerId], references: [id])
  proposal TreatmentProposal? @relation(fields: [proposalId], references: [id])
  plan     TreatmentPlan?     @relation(fields: [planId], references: [id])
  items    InvoiceItem[]
  payments Payment[]
  deposits Deposit[]

  @@index([customerId])
  @@index([proposalId])
  @@index([status])
  @@map("invoices")
}

// ----------------------------------------------------------------------------
// TIỀN CỌC (mục 17) — khoản thu trước khi có hóa đơn (thường từ Booking).
// Cọc là MỘT bản ghi tiền thật, có thể phân bổ (allocate) vào 1 hóa đơn ĐÚNG
// MỘT LẦN. Không đếm trùng: paidAmount hóa đơn = payment (chưa hủy) + cọc đã
// phân bổ vào chính hóa đơn đó. Cọc chưa phân bổ = tiền giữ, chưa trừ công nợ.
// ----------------------------------------------------------------------------
enum DepositStatus {
  ACTIVE // đã thu, chưa phân bổ (đang giữ)
  ALLOCATED // đã phân bổ vào 1 hóa đơn
  REFUNDED // đã hoàn khách
  VOID // hủy phiếu cọc
}

model Deposit {
  id          String        @id @default(cuid())
  code        String        @unique // DC-xxxxxx
  customerId  String
  bookingId   String? // nguồn cọc (nếu từ lịch hẹn)
  invoiceId   String? // hóa đơn đã phân bổ vào (khi ALLOCATED)
  amount      Decimal       @db.Decimal(18, 2)
  method      PaymentMethod @default(CASH)
  txnRef      String?
  status      DepositStatus @default(ACTIVE)
  receivedBy  String?
  receivedAt  DateTime      @default(now())
  allocatedAt DateTime?
  allocatedBy String?
  note        String?
  // --- Hoàn/hủy ---
  refundedAt  DateTime?
  voidedAt    DateTime?
  voidReason  String?
  voidedBy    String?
  createdAt   DateTime      @default(now())

  customer Customer  @relation(fields: [customerId], references: [id])
  booking  Booking?  @relation(fields: [bookingId], references: [id])
  invoice  Invoice?  @relation(fields: [invoiceId], references: [id])

  @@index([customerId])
  @@index([invoiceId])
  @@index([status])
  @@map("deposits")
}

model InvoiceItem {
  id         String  @id @default(cuid())
  invoiceId  String
  name       String // snapshot tên hạng mục
  quantity   Int     @default(1)
  unitPrice  Decimal @default(0) @db.Decimal(18, 2)
  amount     Decimal @default(0) @db.Decimal(18, 2) // = quantity * unitPrice (snapshot)
  note       String?
  orderIndex Int     @default(0)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

// =============================================================================
// CÀI ĐẶT ỨNG DỤNG (mục 1) — cấu hình Thương hiệu/logo lưu DB, KHÔNG hard-code
// rải rác trong mã nguồn. key -> value(JSON).
// =============================================================================

model AppSetting {
  key       String   @id // vd "brand"
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@map("app_settings")
}

// =============================================================================
// NHÂN SỰ (mục 22–24) — 1 người NHIỀU vai trò; vai trò theo BUỔI kèm phí (fee).
// Nhân sự là thực thể riêng (khác User đăng nhập). Tác nhân buổi lưu FK Employee
// + snapshot tên để giữ lịch sử khi nhân sự đổi tên/nghỉ.
// =============================================================================

// Vai trò của nhân sự trong MỘT buổi thực hiện.
enum SessionStaffRole {
  PRIMARY // Kỹ thuật viên chính
  ASSISTANT // Hỗ trợ
  MASTER // Master/chuyên gia
  CHECKER // Kiểm tra/nghiệm thu
  CONSULTANT // Tư vấn/CSKH
}

/// Trạng thái nhân sự (khác availability — xem lib hr). Đang làm/Tạm nghỉ/Nghỉ việc.
enum EmployeeStatus {
  ACTIVE // Đang làm việc
  ON_LEAVE // Tạm nghỉ
  RESIGNED // Nghỉ việc
}

model Employee {
  id         String         @id @default(cuid())
  code       String         @unique // NV-xxxxxx
  fullName   String
  phone      String?
  email      String?
  dob        DateTime? // ngày sinh (mục 8.2)
  title      String? // chức danh chính
  branch     String? // chi nhánh/cơ sở
  startDate  DateTime? // ngày bắt đầu làm việc
  status     EmployeeStatus @default(ACTIVE)
  roles      String[]       @default([]) // đa vai trò (giữ tương thích; nguồn phí = EmployeeRoleFee)
  defaultFee Decimal?       @db.Decimal(18, 2) // phí mặc định (giữ tương thích/mask theo finance.read)
  note       String?
  isActive   Boolean        @default(true) // = status==ACTIVE (giữ tương thích lọc cũ)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  sessionAssignments SessionStaff[]
  roleFees           EmployeeRoleFee[]
  competences        EmployeeCompetence[]
  certifications     EmployeeCertification[]
  schedules          EmployeeSchedule[]
  leaves             EmployeeLeave[]

  @@index([isActive])
  @@index([status])
  @@map("employees")
}

/// Phí theo vai trò của nhân sự, CÓ hiệu lực theo ngày (mục 8.4–8.5). Đổi phí =
/// tạo bản mới, KHÔNG sửa lịch sử; Session/Giá sàn version cũ giữ snapshot.
model EmployeeRoleFee {
  id            String    @id @default(cuid())
  employeeId    String
  role          String // vai trò (KTV chính/Master/Hỗ trợ/Kiểm tra/Tư vấn...)
  fee           Decimal   @default(0) @db.Decimal(18, 2) // phí/buổi (nhạy cảm)
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime? // null = còn hiệu lực
  isActive      Boolean   @default(true)
  note          String?
  createdBy     String?
  createdAt     DateTime  @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, role])
  @@map("employee_role_fees")
}

enum CompetenceKind {
  TECHNOLOGY
  SERVICE
  PROTOCOL
  ROLE
}

/// Năng lực/chuyên môn được phép thực hiện (mục 8.6) — liên kết mềm.
model EmployeeCompetence {
  id         String         @id @default(cuid())
  employeeId String
  kind       CompetenceKind
  refId      String? // id Technology/Service/BrandProtocol (soft)
  name       String // snapshot tên
  note       String?
  createdAt  DateTime       @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([kind, refId])
  @@map("employee_competences")
}

/// Chứng nhận/bằng cấp (mục 8.7) — cảnh báo khi hết hạn.
model EmployeeCertification {
  id         String    @id @default(cuid())
  employeeId String
  name       String
  issuer     String?
  issuedAt   DateTime?
  expiresAt  DateTime?
  mediaId    String? // file tài liệu (MediaAsset) nếu có
  note       String?
  createdAt  DateTime  @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("employee_certifications")
}

/// Lịch làm việc (mục 8.8) — recurring theo thứ (dayOfWeek 0=CN..6=T7).
model EmployeeSchedule {
  id            String    @id @default(cuid())
  employeeId    String
  dayOfWeek     Int // 0..6
  startTime     String // "HH:mm"
  endTime       String // "HH:mm"
  shift         String? // ca (sáng/chiều/tối) nếu có
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("employee_schedules")
}

enum LeaveType {
  ANNUAL // nghỉ phép
  SICK // nghỉ bệnh
  EMERGENCY // nghỉ đột xuất
  UNAVAILABLE // không khả dụng
  OTHER
}

/// Nghỉ phép / không khả dụng (mục 8.9) — chặn gợi ý/booking trong khoảng.
model EmployeeLeave {
  id         String    @id @default(cuid())
  employeeId String
  type       LeaveType @default(ANNUAL)
  fromAt     DateTime
  toAt       DateTime
  reason     String?
  createdBy  String?
  createdAt  DateTime  @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, fromAt])
  @@map("employee_leaves")
}

model SessionStaff {
  id         String           @id @default(cuid())
  sessionId  String
  employeeId String?
  staffName  String // snapshot tên tại thời điểm gán
  role       SessionStaffRole @default(PRIMARY)
  fee        Decimal?         @db.Decimal(18, 2) // phí cho vai trò này ở buổi này (nhạy cảm)
  note       String?
  createdAt  DateTime         @default(now())

  session  TreatmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  employee Employee?        @relation(fields: [employeeId], references: [id])

  @@index([sessionId])
  @@index([employeeId])
  @@map("session_staff")
}

// =============================================================================
// GIÁ SÀN (mục 25–26) — Bảng chi phí cấu thành → tổng chi phí → GIÁ SÀN.
// Bán DƯỚI giá sàn phải có quyền đặc biệt (pricefloor.override) để duyệt.
// Chi phí là dữ liệu nhạy cảm → chỉ finance.read được xem.
// =============================================================================
model ServicePriceFloor {
  id               String   @id @default(cuid())
  serviceId        String   @unique
  laborCost        Decimal  @default(0) @db.Decimal(18, 2) // nhân sự (KTV/master)
  operationCost    Decimal  @default(0) @db.Decimal(18, 2) // vận hành
  depreciationCost Decimal  @default(0) @db.Decimal(18, 2) // khấu hao thiết bị
  materialCost     Decimal  @default(0) @db.Decimal(18, 2) // vật tư
  roomCost         Decimal  @default(0) @db.Decimal(18, 2) // phòng/giường
  otherCost        Decimal  @default(0) @db.Decimal(18, 2) // khác
  minMarginPercent Decimal  @default(0) @db.Decimal(6, 2) // biên lợi nhuận tối thiểu (%)
  note             String?
  updatedBy        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@map("service_price_floors")
}

// =============================================================================
// GIÁ SÀN v2 (mục 7) — Cost breakdown theo DÒNG (6 nhóm) → tổng giá vốn → GIÁ SÀN
// theo margin, có VERSION (V1/V2...) + snapshot bất biến + duyệt dưới sàn có audit.
// Model cũ ServicePriceFloor giữ nguyên (tương thích Booking/checkServicePriceFloor).
// =============================================================================
enum FloorMethod {
  MARGIN // Giá sàn = tổng giá vốn / (1 - margin%) — mặc định
  MARKUP // Giá sàn = tổng giá vốn × (1 + margin%)
  MANUAL // Giá sàn nhập tay có kiểm soát
}

enum FloorVersionStatus {
  DRAFT // Bản nháp
  PENDING_APPROVAL // Chờ duyệt
  APPROVED // Đã duyệt (chưa áp dụng)
  ACTIVE // Đang hiệu lực
  EXPIRED // Hết hiệu lực
  CANCELLED // Hủy
}

enum CostCategory {
  MATERIAL // Vật tư
  STAFF // Nhân sự
  MACHINE // Máy / thiết bị
  ROOM // Phòng / giường
  OPERATION // Vận hành phân bổ
  OTHER // Chi phí khác
}

enum CostCalcType {
  FIXED // Số tiền cố định (đơn giá × số lượng, hoặc trọn buổi)
  PER_MINUTE // theo phút × thời lượng
  PER_SESSION // trọn buổi
  PER_USE // theo lần dùng (× số lượng)
  PERCENT_DIRECT // % trên chi phí trực tiếp (vận hành)
  PER_DURATION // theo thời lượng (giá trị × số phút)
}

model ServicePriceFloorVersion {
  id                 String             @id @default(cuid())
  serviceId          String
  version            Int
  status             FloorVersionStatus @default(DRAFT)
  method             FloorMethod        @default(MARGIN)
  minMarginPercent   Decimal            @default(0) @db.Decimal(6, 2)
  manualFloorPrice   Decimal?           @db.Decimal(18, 2) // khi method=MANUAL
  roundingUnit       Int                @default(1000) // làm tròn lên (đ)
  durationMinutes    Int? // snapshot thời lượng dịch vụ (cho per-minute/duration)
  // --- Snapshot tổng (đông cứng khi publish) ---
  standardPriceSnapshot Decimal @default(0) @db.Decimal(18, 2)
  materialCost       Decimal            @default(0) @db.Decimal(18, 2)
  staffCost          Decimal            @default(0) @db.Decimal(18, 2)
  machineCost        Decimal            @default(0) @db.Decimal(18, 2)
  roomCost           Decimal            @default(0) @db.Decimal(18, 2)
  operationCost      Decimal            @default(0) @db.Decimal(18, 2)
  otherCost          Decimal            @default(0) @db.Decimal(18, 2)
  totalCost          Decimal            @default(0) @db.Decimal(18, 2)
  floorPrice         Decimal            @default(0) @db.Decimal(18, 2)
  maxDiscount        Decimal            @default(0) @db.Decimal(18, 2)
  maxDiscountPercent Decimal            @default(0) @db.Decimal(6, 2)
  // --- Hiệu lực + vết ---
  effectiveFrom      DateTime?
  effectiveTo        DateTime?
  changeReason       String?
  note               String?
  createdBy          String?
  approvedBy         String?
  approvedAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  service Service               @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  lines   PriceFloorCostLine[]

  @@unique([serviceId, version])
  @@index([serviceId, status])
  @@map("service_price_floor_versions")
}

model PriceFloorCostLine {
  id         String       @id @default(cuid())
  versionId  String
  category   CostCategory
  name       String
  quantity   Decimal      @default(1) @db.Decimal(14, 3)
  unit       String?
  unitCost   Decimal      @default(0) @db.Decimal(18, 2) // đơn giá cost
  calcType   CostCalcType @default(FIXED)
  calcValue  Decimal?     @db.Decimal(18, 2) // giá trị theo cách tính (rate/phần trăm)
  minutes    Int? // số phút cho PER_MINUTE/PER_DURATION
  amount     Decimal      @default(0) @db.Decimal(18, 2) // thành tiền (snapshot)
  refId      String? // liên kết mềm SpaProduct/UsageMaterial/vai trò
  source     String? // nguồn cost (vd "Định mức dịch vụ", "Fee vai trò")
  required   Boolean      @default(true)
  note       String?
  orderIndex Int          @default(0)

  version ServicePriceFloorVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId])
  @@map("price_floor_cost_lines")
}

// Bản ghi DUYỆT BÁN DƯỚI GIÁ SÀN (mục 26) — snapshot giá sàn tại thời điểm nghiệp vụ,
// KHÔNG đổi theo version giá sàn về sau. Lưu người duyệt / thời điểm / lý do.
model BelowFloorApproval {
  id             String   @id @default(cuid())
  context        String // PROPOSAL | BOOKING
  serviceId      String?
  floorVersionId String? // version giá sàn dùng để đối chiếu (nếu có)
  proposalId     String?
  invoiceId      String?
  itemName       String? // tên hạng mục/dịch vụ
  standardPrice  Decimal  @default(0) @db.Decimal(18, 2)
  floorPrice     Decimal  @default(0) @db.Decimal(18, 2) // snapshot
  actualPrice    Decimal  @default(0) @db.Decimal(18, 2)
  belowAmount    Decimal  @default(0) @db.Decimal(18, 2)
  belowPercent   Decimal  @default(0) @db.Decimal(6, 2)
  reason         String
  approvedBy     String
  approvedAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  @@index([serviceId])
  @@index([proposalId])
  @@map("below_floor_approvals")
}

// =============================================================================
// CSKH — QUY TRÌNH FOLLOW-UP (mục 31–35). Mẫu quy trình chăm sóc có nhiều BƯỚC
// (mốc ngày + kênh + kịch bản + checklist). Áp cho khách → sinh Task follow-up
// theo lịch. Chương trình sinh nhật/loyalty tách khỏi Marketing.
// =============================================================================
enum FollowUpTrigger {
  AFTER_SERVICE // sau khi dùng dịch vụ
  AFTER_SESSION // sau một buổi điều trị
  BIRTHDAY // sinh nhật
  MANUAL // áp thủ công
}

model FollowUpTemplate {
  id          String          @id @default(cuid())
  code        String          @unique // CS-xxxxxx
  name        String
  description String?
  trigger     FollowUpTrigger @default(MANUAL)
  isActive    Boolean         @default(true)
  createdBy   String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  steps FollowUpStep[]

  @@map("followup_templates")
}

model FollowUpStep {
  id         String          @id @default(cuid())
  templateId String
  orderIndex Int             @default(0)
  dayOffset  Int             @default(0) // số ngày sau mốc (anchor) để đến hạn
  channel    DeliveryChannel @default(IN_PERSON)
  title      String // việc cần làm (vd "Gọi hỏi thăm sau 1 ngày")
  script     String? // kịch bản/nội dung mẫu
  checklist  String[]        @default([]) // các mục cần kiểm

  template FollowUpTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@map("followup_steps")
}

// =============================================================================
// ĐÁNH GIÁ SAU BUỔI (mục 36–37) — Khách chấm điểm hài lòng + đánh giá kỹ thuật
// viên; kèm BÁO CÁO của kỹ thuật viên sau buổi. 1 đánh giá / buổi (upsert).
// =============================================================================
model SessionReview {
  id                String   @id @default(cuid())
  sessionId         String   @unique
  customerId        String
  satisfactionScore Int? // điểm hài lòng chung (1–5)
  technicianScore   Int? // điểm đánh giá kỹ thuật viên (1–5)
  technicianName    String? // KTV được đánh giá (snapshot tên)
  comment           String? // nhận xét của khách
  wouldReturn       Boolean? // khách sẽ quay lại?
  technicianReport  String? // báo cáo của KTV sau buổi (nội bộ)
  reviewedBy        String? // người ghi nhận
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  session TreatmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("session_reviews")
}

// ============================================================================
// Danh mục TÀI NGUYÊN đặt lịch (mục 25) — Phòng / Giường / Máy để Booking chọn
// từ danh mục thay vì gõ tự do. Giường có thể thuộc một Phòng (parentId).
// ============================================================================
enum ResourceType {
  ROOM
  BED
  MACHINE
}

model BookingResource {
  id        String       @id @default(cuid())
  code      String?      @unique
  name      String
  type      ResourceType
  parentId  String? // giường thuộc phòng nào
  isActive  Boolean      @default(true)
  note      String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  parent   BookingResource?  @relation("ResourceParent", fields: [parentId], references: [id])
  children BookingResource[] @relation("ResourceParent")

  @@index([type])
  @@map("booking_resources")
}
