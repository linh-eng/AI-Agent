# =============================================================================
# Biến môi trường — KHÔNG commit giá trị bí mật thật. File này chỉ là mẫu.
# Sinh secret ngẫu nhiên: `openssl rand -base64 48`
# =============================================================================

# --- Database (Prisma / PostgreSQL) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# --- Bí mật ký JWT (BẮT BUỘC ở production, PHẢI khác nhau) ---
# Phiên NHÂN VIÊN (staff). Đổi giá trị thật, đủ dài (>= 32 bytes ngẫu nhiên).
AUTH_SECRET="CHANGE_ME_staff_random_secret"
# Phiên CỔNG KHÁCH (customer portal) — TÁCH RIÊNG với staff.
# Nếu bỏ trống, hệ thống tự phái sinh từ AUTH_SECRET + hậu tố (vẫn khác staff),
# nhưng production NÊN đặt giá trị riêng độc lập.
PORTAL_AUTH_SECRET="CHANGE_ME_portal_random_secret"

# --- Thời gian sống phiên (giây) ---
SESSION_MAX_AGE="28800"          # staff, mặc định 8 giờ
PORTAL_SESSION_MAX_AGE="604800"  # portal, mặc định 7 ngày

# --- Rate limit đăng nhập ---
LOGIN_THROTTLE_WINDOW_MS="900000" # cửa sổ đếm thất bại (ms), mặc định 15 phút

# --- Tồn kho ---
ALLOW_NEGATIVE_STOCK="false"     # true = cho phép xuất vượt tồn (mặc định false)

# --- Lưu trữ media ---
STORAGE_DRIVER="local"           # local | s3
STORAGE_DIR="./var/uploads"      # (local) thư mục blob RIÊNG TƯ, ngoài public/
STORAGE_MAX_BYTES="26214400"     # 25MB
STORAGE_SIGNED_URL_TTL="300"     # TTL (giây) cho signed URL, mặc định 5 phút

# --- Object storage S3 (khi STORAGE_DRIVER=s3) ---
S3_BUCKET=""
S3_REGION=""
S3_ENDPOINT=""                   # để trống nếu dùng AWS chuẩn; đặt URL nếu MinIO/R2/…
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"      # true cho MinIO/một số S3-compatible
