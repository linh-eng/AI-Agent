# PostgreSQL — kết nối DB (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sophia_wellness?schema=public"

# Bí mật ký JWT (đổi giá trị này ở môi trường thật)
AUTH_SECRET="thay-doi-chuoi-bi-mat-nay-bang-mot-gia-tri-ngau-nhien-dai"

# Thời gian sống của phiên đăng nhập (giây) — mặc định 8 giờ
SESSION_MAX_AGE="28800"

# Cookie phiên yêu cầu HTTPS? Để trống/false khi chạy HTTP nội bộ (LAN) để đăng nhập được.
# Chỉ đặt "true" khi đã có HTTPS (chạy sau tên miền + SSL).
COOKIE_SECURE="false"
