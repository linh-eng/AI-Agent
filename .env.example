# PostgreSQL — kết nối DB (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/thng_warehouse?schema=public"

# Bí mật ký JWT — BẮT BUỘC đổi giá trị này ở môi trường thật (chuỗi ngẫu nhiên dài)
# Tạo nhanh: openssl rand -base64 48
AUTH_SECRET="thay-doi-chuoi-bi-mat-nay-bang-mot-gia-tri-ngau-nhien-dai"

# Thời gian sống của phiên đăng nhập (giây) — mặc định 8 giờ
SESSION_MAX_AGE="28800"

# Cổng web (mặc định 3000). Nhân viên truy cập http://<IP-máy-chủ>:PORT
PORT="3000"

# QUAN TRỌNG khi chạy MẠNG NỘI BỘ qua http:// (không có HTTPS):
#   đặt COOKIE_SECURE=false để trình duyệt gửi lại cookie đăng nhập.
#   Nếu chạy sau HTTPS (có chứng chỉ) thì đặt true.
COOKIE_SECURE="false"
