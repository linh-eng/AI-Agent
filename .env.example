# =============================================================================
# Biến môi trường — KHÔNG commit giá trị bí mật thật. File này chỉ là mẫu.
# Sinh secret ngẫu nhiên: `openssl rand -base64 48`
#
# BA MÔI TRƯỜNG (mỗi môi trường có DB + bucket + secret + URL RIÊNG, không dùng chung):
#   * development : máy dev; STORAGE_DRIVER=local; DB local; secret dev.
#   * staging     : gần production; DB staging riêng; STORAGE_DRIVER=s3 (bucket private
#                   riêng); secret staging riêng; APP_URL=https://staging.<domain>.
#   * production  : (PHASE SAU) DB + bucket + secret + domain riêng, tách hẳn staging.
# LƯU Ý serverless (Vercel): filesystem KHÔNG bền vững → staging/production PHẢI dùng
#   STORAGE_DRIVER=s3 (local chỉ hợp lệ cho development).
# =============================================================================

# --- Môi trường ---
NODE_ENV="production"            # staging build dùng "production" để bật secure cookies
APP_ENV="staging"                # nhãn nội bộ: development | staging | production

# --- Cookie Secure ---
# Mặc định: bật Secure khi NODE_ENV=production (cần HTTPS). Khi chạy HTTP trong
# MẠNG NỘI BỘ (không HTTPS) PHẢI đặt "false" để đăng nhập hoạt động.
COOKIE_SECURE="false"

# --- Cổng chạy (mạng nội bộ) ---
# Server này đã dùng 3000 (Webapp Hỗ Trợ) và 9000 (Kho Sophia) → chọn cổng khác,
# ví dụ 9500. Khởi động: next start -H 0.0.0.0 -p 9500  (hoặc đặt PORT=9500).
PORT="9500"

# --- Tên thương hiệu hiển thị (login, sidebar, cổng khách, tiêu đề tab) ---
# Đổi tên spa của bạn tại đây. LƯU Ý: biến NEXT_PUBLIC → phải BUILD LẠI sau khi đổi.
NEXT_PUBLIC_BRAND_NAME="Sophia Wellness"

# --- Chế độ Spa: ẩn nhóm menu "Kho THNG" (phần cứng) để giao diện thuần Spa ---
# "true" = ẩn Kho THNG (khuyến nghị cho bản demo spa). "false" = hiện đủ cả 2 module.
# LƯU Ý: đây là biến NEXT_PUBLIC → phải BUILD LẠI (npm run build) sau khi đổi.
NEXT_PUBLIC_HIDE_WAREHOUSE="true"

# --- URL ứng dụng (KHÔNG hard-code domain trong code) ---
APP_URL="http://172.168.11.60:9500"        # dùng cho callback / liên kết tuyệt đối (server)
NEXT_PUBLIC_APP_URL="http://172.168.11.60:9500"  # bản public cho client nếu cần

# --- Database (Prisma / PostgreSQL) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public&sslmode=require"

# --- Bí mật ký JWT (BẮT BUỘC ở production, PHẢI khác nhau) ---
# Phiên NHÂN VIÊN (staff). Đổi giá trị thật, đủ dài (>= 32 bytes ngẫu nhiên).
AUTH_SECRET="CHANGE_ME_staff_random_secret"
# Phiên CỔNG KHÁCH (customer portal) — TÁCH RIÊNG với staff.
# Nếu bỏ trống, hệ thống tự phái sinh từ AUTH_SECRET + hậu tố (vẫn khác staff),
# nhưng production NÊN đặt giá trị riêng độc lập.
PORTAL_AUTH_SECRET="CHANGE_ME_portal_random_secret"

# --- Thời gian sống phiên (giây) ---
SESSION_MAX_AGE="28800"          # staff, mặc định 8 giờ
PORTAL_SESSION_MAX_AGE="604800"  # portal, mặc định 7 ngày

# --- Rate limit đăng nhập ---
LOGIN_THROTTLE_WINDOW_MS="900000" # cửa sổ đếm thất bại (ms), mặc định 15 phút

# --- Tồn kho ---
ALLOW_NEGATIVE_STOCK="false"     # true = cho phép xuất vượt tồn (mặc định false)

# --- Lưu trữ media ---
STORAGE_DRIVER="local"           # local | s3
STORAGE_DIR="./var/uploads"      # (local) thư mục blob RIÊNG TƯ, ngoài public/
STORAGE_MAX_BYTES="26214400"     # 25MB
STORAGE_SIGNED_URL_TTL="300"     # TTL (giây) cho signed URL, mặc định 5 phút

# --- Object storage S3-compatible (khi STORAGE_DRIVER=s3): AWS S3 / Cloudflare R2 / MinIO ---
# BẮT BUỘC bucket PRIVATE (không public ACL). Object mã hóa at-rest (SSE-AES256).
S3_BUCKET=""                     # tên bucket private RIÊNG cho môi trường này
S3_REGION=""                     # vd "auto" cho R2, "ap-southeast-1" cho AWS
S3_ENDPOINT=""                   # để trống nếu AWS chuẩn; R2: https://<acct>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=""              # ĐẶT TRONG dashboard/secret manager — KHÔNG commit
S3_SECRET_ACCESS_KEY=""          # ĐẶT TRONG dashboard/secret manager — KHÔNG commit
S3_FORCE_PATH_STYLE="false"      # true cho MinIO/R2 (một số cấu hình)

# --- Monitoring / logging ---
LOG_LEVEL="info"                 # debug | info | warn | error (mặc định info)
SENTRY_DSN=""                    # (tùy chọn) cắm error-tracking; trống = chỉ log JSON ra stdout

# --- Dọn rác throttle (tùy chọn, dùng cho cron ngoài) ---
# DELETE FROM auth_throttles WHERE locked_until < now() AND updated_at < now() - interval '1 day';
